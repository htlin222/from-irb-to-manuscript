[1840.822817, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✳\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1840.83496, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m 24 +\u001b[38;5;236mblocks <- split(seq_len(nrow(full)), findInterval(seq_len(nrow(full)), starts))                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 25 +\u001b[38;5;236mparts <- list(); cur <- integer()                                                                    \r\u001b[5C\u001b[1B\u001b[38;5;29m 26 +\u001b[38;5;236mfor (b in blocks) {                                                                                  \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[11G\u001b[38;5;236m  if (length(\u001b[25Gur) + length(b) > journal$limits$table_max_rows)\u001b[74G{\u001b[76Gparts[[length(parts)\u001b[97G+\u001b[99G1]]\u001b[103G<-\u001b[106Gcur;\u001b[111Gc\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236mur <- integer() }                                                                                    \r\u001b[5C\u001b[1B\u001b[38;5;29m 28 +\u001b[38;5;236m  cur <- c(cur, b)                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 29 +\u001b[38;5;236m}                                                                                                    \r\u001b[5C\u001b[1B\u001b[38;5;29m 3"]
[1840.835087, "o", "0 +\u001b[38;5;236mparts[[length(parts) + 1]] <- cur                                                                    \r\u001b[5C\u001b[1B\u001b[38;5;29m 31 +\u001b[38;5;236mshow <- copy(full)                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 32 +\u001b[38;5;236mshow[is.na(SMD), Characteristic := paste0(\"  \", Characteristic)]                                     \r\u001b[5C\u001b[1B\u001b[38;5;29m 33 +\u001b[38;5;236mshow[, SMD := ifelse(is.na(SMD), \"\", sprintf(\"%.2f\", SMD))]                                          \r\u001b[5C\u001b[1B\u001b[38;5;29m 34 +\u001b[38;5;236msupp_tables <- lapply(seq_along(parts), function(i) list(                                            \r\u001b[5C\u001b[1B\u001b[38;5;29m 35 +\u001b[38;5;236m  title = sprintf(\"Table S1%s. Baseline characteristics, all categories (part %d of %d)\", letters[i],\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m i,\u001b[15Glength(parts)),\r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[13G\u001b[38;5;236mdata\u001b[18G=\u001b[20Gshow[parts[[i]]]))\r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[11G\u001b[38;5;236msg <- fread(\"results/outcomes_subgroup.csv\")\r\u001b[5C\u001b[1B\u001b[38;5;29m "]
