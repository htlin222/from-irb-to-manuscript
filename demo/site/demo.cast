[2191.077405, "o", "─┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B第二輪決定信沒有寫交回期限。\u001b[38G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m檢查結果\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G修訂版檢查全部通過，包括\u001b[30G9\u001b[32G處修改都找到頁碼。\r\u001b[2C\u001b[1B- 獨立檢查程式：\u001b[1m59/59 通過\u001b[22m。摘要\u001b[36G246\u001b[40G字（上限\u001b[49G250），正文\u001b[61G2,822\u001b[67G字（上限\u001b[76G4,000）。\r\u001b[2C\u001b[1B-\u001b[5G139\u001b[9G項測試、41\u001b[20G項分析定義測試、程式碼檢查都通過。\r\u001b[4C\u001b[1B結果檔記錄的都是已存檔的程式版本。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B這次也順便修好兩個程式問題：\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[2191.369698, "o", "\u001b[?25l\u001b[H\u001b[3G├──────────────────────────────────┼─────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ \u001b[38;5;105mJCRP_revised_article_marked.docx\u001b[39m │ 標示版修訂稿，以第一次修訂為比對基準                                        │\r\u001b[2C\u001b[1B├──────────────────────────────────┼─────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ \u001b[38;5;105mJCRP_revised_article_clean.docx\u001b[39m  │ 乾淨修訂稿                                                                  │\r\u001b[2C"]
