[1483.307672, "o", "\u001b[5C\u001b[1B\u001b[49m\u001b[2m 47 \u001b[22m   flextable::width(x, width = w * min(1, page / sum(w)))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 48 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 49 \u001b[22m footnotes <- function(t) knitr::asis_output(paste0(\"\\n\", paste(t$footnotes, collapse = \"\\n\\n\"), \"\\n\")\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22m)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m三張表現在都清楚易讀了，Table\u001b[33G2\r\u001b[2C\u001b[1B的信賴區間偶爾分成兩行是可接受的。接下來我會跑全部測試和程式碼檢查，確認寫作指引裡的數字正確後存檔。\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39mRunning tests, linting, and sanity-check\u001b[44Gthe\u001b[48Gwriting\u001b[56Gguide\r\u001b[1B\u001b[38;5;241m  ⎿  $ make test 2>&1 | tail -1; make test-analysis 2>&1 | grep definitions; make lint 2>&1 | tail -2; grep -o '2.01 \r\u001b[5C\u001b[1B(95% CI, 1.12–3.62)' manuscript/_build/writing_guide.html | head -1; grep -c '{{' \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mmanuscript/_build/writing_"]
