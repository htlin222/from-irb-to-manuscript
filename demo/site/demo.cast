[1278.588948, "o", "4\u001b[12G\u001b[22m\u001b[38;5;246m執行\u001b[20Gke references\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m  library(yaml); library(jsonlite); library(data.table)\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m})\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[10G\u001b[22mrefs \u001b[38;5;125m<-\u001b[38;5;236m read_yaml(\u001b[38;5;24m\"manuscript/references.yaml\"\u001b[38;5;236m)\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22mua \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;24m\"her2-neoadjuvant-study reference check (R jsonlite)\"\r\u001b[5C\u001b[1B\u001b[38;5;241m… +104 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mVerifying all references\u001b[28Gagainst\u001b[36GCrossref\u001b[45Gand\u001b[49GPubMed\r\u001b[1B\u001b[38;5;241m  ⎿  $ Rscript -e 'cat(requireNamespace(\"curl\", quietly=TRUE), \"\\n\")' && time Rscript manuscript/verify_references.R \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m2>&1 | tail -40\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;174m✻\u001b[3G\u001b[38;5;216mCoalescing…\u001b[19G\u001b[38;5;241m8\u001b[29G4\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
