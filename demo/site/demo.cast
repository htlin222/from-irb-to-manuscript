[563.540574, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mUpdated \u001b[1manalysis/R/validate_raw.R\u001b[22m \u001b[38;5;241m(+2 -2)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 3 \u001b[22m \u001b[38;5;246m# 不輸出病歷號、生日或任何個別病人資料；不比較兩組的療效。\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;246m# 有「錯誤」等級的項目時以非零狀態結束，讓 make 停下來。\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 5 \u001b[22m source(\u001b[38;5;24m\"analysis/R/common.R\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m6 +\u001b[38;5;236msource(\u001b[38;5;24m\"analysis/R/definitions.R\"\u001b[38;5;236m) \u001b[46G     \u001b[52G       \u001b[60G   \u001b[64G        \u001b[73G     \u001b[79G   \u001b[83G  \u001b[86G   \u001b[90G    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 7 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 8 \u001b[22m manifest \u001b[38;5;125m<-\u001b[38;5;236m verify_manifest()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 9 \u001b[22m p \u001b[38;5;125m<-\u001b[38;5;236m params()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m...\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 74 \u001b[22m ki67 \u001b[38;5;125m<-\u001b[38;5;236m reg\u001b[38;5;125m$\u001b[38;5;236mki67\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m 75 \u001b[22m ad"]
