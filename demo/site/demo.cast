[426.375058, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;5;16m⏺\u001b[39m 我會檢查資料本身可不可靠，例如欄位、合理範圍、重複、日期先後、各檔能不能對得上。但不會去比較兩組的 pCR\u001b[K\r\u001b[2C\u001b[1B或存活，以免在分析計畫定案前先看到結果。報告裡只放彙總數字，不放病歷號或生日。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B先確認 R 的環境，再對資料做一次整體盤點。\u001b[K\r\u001b[2C\u001b[2B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m⏺\u001b[3G\u001b[39m盤點完成，已經看到幾個需要追查的地方。接著看各藥物的劑量分布和跨檔案的對應情況，作為正式檢查程式的依據。\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m⏺\u001b[3G\u001b[39m確認檢查方向後，我把所有驗證邏輯寫成正式程式放進\u001b[52G\u001b[38;5;105manalysis/\u001b[39m，之後只要跑\u001b[74G\u001b[38;5;105mmake data-check\r\u001b[2C\u001b[1B\u001b[39m就能重新檢查資料更新；藥名對照表也獨立存成一份，供日後分組共用。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mConfirmin"]
[426.375188, "o", "g R can read study facts from config.toml\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ Rscript -e 'x <- RcppTOML::parseTOML(\"config.toml\"); cat(x$dates$data_period, \"\\n\"); cat(x$study$irb_no, \"\\n\")'\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[1mWrite\u001b[22m(\u001b]8;id=nvwgry;file:///Users/Shared/her2-neoadjuvant-study/analysis/drug_map.csv\u0007analysis/drug_map.csv\u001b]8;;\u0007)\u001b[K\r\u001b[18C\u001b[2B\u001b[38;5;241m4\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[426.37769, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m確認檢查方向後，我把所有驗證邏輯寫成正式程式放進\u001b[52G\u001b[38;5;105manalysis/\u001b[39m，之後只要跑\u001b[74G\u001b[38;5;105mmake data-check\r\u001b[1B\u001b[39m \u001b[3G就能重新檢查資料更新；藥名對照表也獨立存成一份，供日後分組共用。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mConfirming\u001b[14GR\u001b[16Gcan\u001b[20Gread\u001b[25Gstudy\u001b[31Gfacts\u001b[37Gfrom\u001b[42Gconfig.toml\r\u001b[1B\u001b[38;5;241m  ⎿  $ Rscript -e 'x <- RcppTOML::parseTOML(\"config.toml\"); cat(x$dates$data_period, \"\\n\"); cat(x$study$irb_no, \"\\n\")'\r\u001b[2B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=nvwgry;file:///Users/Shared/her2-neoadjuvant-study/analysis/drug_map.csv\u0007analysis/drug_map.csv\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m26\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1manalysis/drug_map.csv\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;5;236m\u001b[2m  1 \u001b[22mraw_name,agent,agent_class,market_from\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22mHerceptin,trastuzumab,anti_her2,\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m  3 \u001b[22mHERCEPTIN 440MG INJ,trastuzuma"]
