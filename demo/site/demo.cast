[408.364977, "o", "放病歷號或生日。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B先確認\u001b[10GR\u001b[12G的環境，再對資料做一次整體盤點。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mChecking available R packages and project layout\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ Rscript -e 'for (p in \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;241mc(\"yaml\",\"RcppTOML\",\"data.table\",\"dplyr\",\"readr\",\"tidyr\",\"stringr\",\"jsonlite\",\"testthat\",\"digest\",\"lubridate\")) \r\u001b[5C\u001b[1Bcat(p, requireNamespace(p, quietly=TRUE), \"\\n\"); cat(R.version.string, \"\\n\")'; ls analysis results 2>&1; sed -n \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m1,15p Makefile\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
