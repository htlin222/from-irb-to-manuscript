[645.880188, "o", "                                         \r\u001b[5C\u001b[1B\u001b[38;5;29m 102 +\u001b[38;5;236mtest_that(\u001b[38;5;24m\"percent fields parse with or without % and receptor cut-off is inclusive\"\u001b[38;5;236m, {             \r\u001b[5C\u001b[1B\u001b[38;5;29m 103 +\u001b[38;5;236m  expect_equal(parse_pct(\u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"64%\"\u001b[38;5;236m, \u001b[38;5;24m\"64\"\u001b[38;5;236m, \u001b[38;5;24m\" 5% \"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m, \u001b[38;5;24m\"n/a\"\u001b[38;5;236m)), \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;31m64\u001b[38;5;236m, \u001b[38;5;31m64\u001b[38;5;236m, \u001b[38;5;31m5\u001b[38;5;236m, \u001b[38;5;31mNA\u001b[38;5;236m, \u001b[38;5;31mNA\u001b[38;5;236m))                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 104 +\u001b[38;5;236m  expect_equal(receptor_positive(\u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"0\"\u001b[38;5;236m, \u001b[38;5;24m\"1\"\u001b[38;5;236m, \u001b[38;5;24m\"0.5\"\u001b[38;5;236m, \u001b[38;5;24m\"90\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m), cutoff \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m1\u001b[38;5;236m), \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;31mFALSE\u001b[38;5;236m, \u001b[38;5;31mTRUE\u001b[38;5;236m, \u001b[38;5;31mFALSE\u001b[38;5;236m, \u001b[38;5;31mTR\r\u001b[5C\u001b[1B\u001b[38;5;29m     +\u001b[38;5;31mUE\u001b["]
