[1024.647459, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m 60 +\u001b[38;5;31mreasons\u001b[38;5;236m            = [\u001b[38;5;24m\"研究設計變更\"\u001b[38;5;236m, \u001b[38;5;24m\"統計分析方法與研究終點用語\"\u001b[38;5;236m]   \u001b[38;5;246m# 不在 SF015 勾選項者列入「其他\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;246m」\u001b[38;5;236m                                                                                                   \r\u001b[6C\u001b[1B\u001b[38;5;29m61\u001b[11G\u001b[38;5;31mchange_description\u001b[32G\u001b[38;5;24m\"@correspondence/IRB修正案1_修正說明.md\"\r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[11G\u001b[38;5;31mbaseline\u001b[32G\u001b[38;5;24m\"irb-approved:中文計畫摘要.md\"\u001b[38;5;236m   \u001b[38;5;246m# SF016：核准版（git tag:檔案）vs 目前版，自動\u001b[38;5;236m \r\u001b[10C\u001b[1B\u001b[38;5;246m逐段比對\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;236m\u001b[2m 63 \u001b[22m \u001b[38;5;31maffects_consent\u001b[38;5;236m    = \u001b[38;5;31mfalse\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 64 \u001b[22m \u001b[38;5;31maffects_risk\u001b[38;5;236m       = \u001b[38;5;31mfalse\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 65 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m程式"]
[1024.648992, "o", "正確抓到 4 個有改動的段落。接著產生修正案全套表單。\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m5\u001b[5G份表單都產生了，版面檢查\u001b[30G0\u001b[32G錯誤，字型都是標楷體，修正後的計畫摘要仍維持\u001b[77G2\u001b[79G頁。我逐份看內容，先看最重要的\u001b[110GSF016\r\u001b[2C\u001b[1B對照表。\u001b[K\r\u001b[2B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ cd \"$TMPDIR\" && rm -rf amend && mkdir amend && for f in SF015_修正案申請表 SF016_修正前後對照表 \r\u001b[5C\u001b[1BSF014_修正案審查送審資料表; do pdftoppm -r 70 -png \"/Users/Shared/her2-neoadjuvant-study/output/$f.pdf\" \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m\"amend/$f\"; done; ls amend\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
