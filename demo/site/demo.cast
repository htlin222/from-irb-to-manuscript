[590.99782, "o", "\u001b[?25l\u001b[H\r\u001b[4B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1ag9qmn;file:///Users/Shared/her2-neoadjuvant-study/analysis/R/cohort.R\u0007analysis/R/cohort.R\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m3\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 74 \u001b[22m \u001b[38;5;246m# 排除框：標題一行，每個理由一個項目符號，過長自動換行（續行縮排）\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 75 \u001b[22m bullets \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(s, mark \u001b[38;5;125m=\u001b[38;5;236m character()) {\r\u001b[5C\u001b[1B\u001b[2m 76 \u001b[22m   r \u001b[38;5;125m<-\u001b[38;5;236m flow[step \u001b[38;5;125m==\u001b[38;5;236m s]\r\u001b[1B\u001b[39m     \u001b[38;5;160m\u001b[48;5;224m 77 -\u001b[38;5;236m  items <- sprintf(\"%s%s (n = %d)\", r$reason, ifelse(r$reason %in% mark, \"†\", \"\"), r$n)              \r\u001b[5C\u001b[1B\u001b[38;5;160m 78 -\u001b[38;5;236m  wrapped <- unlist(lapply(items, function(x) {                                                      \r\u001b[5C\u001b[1B\u001b[38;5;160m 79 -\u001b[38;5;236m    w <- strwrap(x, width = 46)                                       "]
