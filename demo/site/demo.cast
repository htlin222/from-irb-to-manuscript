[2011.110533, "o", "版本上並更新說明，因為舊版本缺少顏色和頁碼\u001b[61G也還沒對外發布過。\u001b[K\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39mCommitting the visible-changes\u001b[34Grevision\u001b[43Gand\u001b[47Gtag\u001b[51Git\u001b[54Gas\u001b[57Gthe\u001b[61Gfirst\u001b[67Grevision\r\u001b[1B\u001b[38;5;241m  ⎿  $ git add correspondence manuscript submission/revision1 && git commit -q -F - <<'EOF'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mMake every change visible to reviewers (first revision)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241m- Insertions use the Word character style \"Inserted Text\" (blue, underlined)\r\u001b[5C\u001b[1Band deletions \"Deleted Text\" (red, struck through), defined in\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mstyle/reference.…\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
