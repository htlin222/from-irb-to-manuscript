[1433.123536, "o", "\u001b[?25l\u001b[H     \u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;246m# Single source of truth: config.toml (+ the files it references, e.g. cv.toml, 中文計畫摘要.md)\r\u001b[5C\u001b[1B\u001b[38;5;241m...\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[10G\u001b[22m ref\u001b[15Grences: ## Verify every reference in manuscript/references.yaml against Crossref + PubMed → refer\r\u001b[7C\u001b[1B\u001b[2m \u001b[10G\u001b[22m ences.bib\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m83\u001b[10G\u001b[22m         \u001b[38;5;31m$(RSCRIPT)\u001b[38;5;236m manuscript/verify_references.R\r\u001b[6C\u001b[1B\u001b[2m84\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 85 +\u001b[38;5;236mmanuscript: ## Build the JCRP draft (title page, blinded article, JPEG figures, writing guide) + chec\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236mks → manuscript/_build/                                                                              \r\u001b[5C\u001b[1B\u001b[38;5;29m 86 +\u001b[38;5;236m        @test -f manuscript/style/reference.docx || { quarto pandoc -o manuscript/_build/pandoc-refer\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236mence.docx --print-default-data-file reference.docx && \u001b[38;5;"]
[1433.123664, "o", "31m$(RUN)\u001b[38;5;236m python manuscript/style/make_reference_d\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236mocx.py manuscript/_build/pandoc-reference.docx manuscript/style/reference.docx; }                    \r\u001b[5C\u001b[1B\u001b[38;5;29m 87 +\u001b[38;5;236m        \u001b[38;5;31m$(RSCRIPT)\u001b[38;5;236m manuscript/R/build.R draft                                                        \r\u001b[5C\u001b[1B\u001b[38;5;29m 88 +\u001b[38;5;236m                                                                                                     \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 89 +\u001b[38;5;236msubmission: ## Same as manuscript, but only writes submission/ when every JCRP check passes          \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;29m\u001b[48;5;194m 90 +\u001b[38;5;236m        \u001b[38;5;31m$(RSCRIPT)\u001b[38;5;236m manuscript/R/build.R submission                                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 91 +\u001b[38;5;236m                                                                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 92 \u001b[22m test: ## Run tests\u001b[39m\u001b[K\r\u001b[5"]
