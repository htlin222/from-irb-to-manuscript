[2250.994731, "o", "29m200\u001b[12G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"SF038: closure.report sections fill the report; background falls back to the proposal; others\r\u001b[6C\u001b[1B\u001b[38;5;29m   \u001b[12G\u001b[38;5;24m keep the placeholder.\"\"\"\u001b[38;5;236m            \u001b[50G \u001b[52G                \u001b[69G                  \u001b[88G          \u001b[99G             \r\u001b[6C\u001b[1B\u001b[38;5;29m201\u001b[12G\u001b[38;5;236m    retro_config[\u001b[38;5;24m\"closure\"\u001b[38;5;236m][\u001b[38;5;24m\"report\"\u001b[38;5;236m]\u001b[50G=\u001b[52G{\u001b[38;5;24m\"participants\"\u001b[38;5;236m:\u001b[69G\u001b[38;5;24m\"共收案 882 人。\"\u001b[38;5;236m,\u001b[88G\u001b[38;5;24m\"results\"\u001b[38;5;236m:\u001b[99G\u001b[38;5;24m\"主要結果如下\r\u001b[6C\u001b[1B\u001b[38;5;29m   \u001b[12G\u001b[38;5;24m。\"\u001b[38;5;236m}                        \u001b[41G \u001b[43G              \u001b[58G             \r\u001b[8C\u001b[1B\u001b[38;5;29m2\u001b[16G\u001b[38;5;236mr\u001b[18Gtro_config[\u001b[38;5;24m\"proposal\"\u001b[38;5;236m] = {\u001b[38;5;24m\"background\"\u001b[38;5;236m: \u001b[38;5;24m\"背景說明。\"\u001b[38;5;236m}           \u001b[83G            \r\u001b[8C\u001b[1B\u001b[38;5;29m3\u001b[16G\u001b[38;5;236mtext = docx_text(generate_all.generate_form(\u001b[38;5;24m\"SF038\"\u001b[38;5;236m, retro_config, outpu"]
