[269.458117, "o", "2m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m⏺\u001b[3G\u001b[39m計畫摘要加了內容仍是\u001b[24G2\u001b[26G頁。SF019\u001b[36G因為回覆比較長，從空白表單的\u001b[65G2\u001b[67G頁變成\u001b[74G3\u001b[76G頁，我看一下排版有沒有問題。\r\u001b[2B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRendering all SF019 pages to PNG\u001b[36G\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ cd \"$TMPDIR\" && rm -rf sf019 && mkdir sf019 && pdftoppm -r 60 -png \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m/Users/Shared/her2-neoadjuvant-study/output/SF019_複審案申請表.pdf sf019/p && ls sf019\r\u001b[2C\u001b[2B\u001b[38;5;174mMul\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
