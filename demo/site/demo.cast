[102.883255, "o", "\u001b[?25l\u001b[H\r\u001b[10B\u001b[38;5;241m⏺\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[102.937074, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m設定檢查通過。接著產生表單、轉\u001b[34GPDF，並跑版面檢查。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file, ran \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m摘要超出兩頁限制約\u001b[22G8\r\u001b[1B \u001b[3G行，而且表單已自動加入「本研究採回溯性世代研究設計」一句，與我原寫內容重複。我這就精簡摘要內容。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mShorten\u001b[11Gsummary\u001b[19Gand\u001b[23Gregenerate\u001b[34Gforms\u001b[38;5;241m · 2s\r\u001b[1B  ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;241mim\u001b[9Gort pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp = pathlib.Path(\"中文計畫摘要.md\"); s = p.read_text()\r\u001b[5C\u001b[1Bstart = s.index(\"## 研究背景\")\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;241m = s[:start] + \u001b[23G\"\"## 研究背景\r\u001b[5C\u001b[1BHER2陽性第II–III期乳癌常於手術前先接受化療合併抗HER2標靶治療（術前輔助治療），術後病理完全反應（pCR）與較佳長期預\r\u001b[5C\u001b[1B後相關。\u001b[39m\u001b[K\r\u001b[5C"]
[102.937476, "o", "\u001b[1B\u001b[38;5;241mNeoSphere等臨床試驗顯示，加上pertuzumab可提高pCR比例。本院術前治療由化療合併trastuzumab逐步轉為合併trastuzumab與p\r\u001b[5C\u001b[1Bertuzumab雙標靶… (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m(c\u001b[9Grl+b ctrl+b (twice) to run in background)\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
