[1969.363076, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 89 \u001b[22m             set_font(styles[name], \u001b[38;5;31m12\u001b[38;5;236m, bold=\u001b[38;5;31mTrue\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 90 \u001b[22m             double_space(styles[name])\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 91 \u001b[22m             styles[name].paragraph_format.space_before = Pt(\u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m92\u001b[15G\u001b[38;5;236madd_change_styles(doc)\r\u001b[6C\u001b[1B\u001b[49m\u001b[2m93\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;125mfor\u001b[38;5;236m section \u001b[38;5;125min\u001b[38;5;236m doc.sections:\r\u001b[6C\u001b[1B\u001b[2m94\u001b[15G\u001b[22m   \u001b[19G\u001b[38;5;125mfor\u001b[38;5;236m sid\u001b[27G \u001b[38;5;125min\u001b[38;5;236m (\u001b[38;5;24m\"top_margin\"\u001b[38;5;236m, \u001b[38;5;24m\"bottom_margin\"\u001b[38;5;236m, \u001b[38;5;24m\"left_margin\"\u001b[38;5;236m, \u001b[38;5;24m\"right_margin\"\u001b[38;5;236m):\r\u001b[6C\u001b[1B\u001b[2m95\u001b[15G\u001b[22m      \u001b[22G \u001b[38;5;31msetattr\u001b[38;5;236m(section, side, Cm(\u001b[38;5;31m2.5\u001b[38;5;236m))\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  … 1 more file changed\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m兩個樣式已建好：新增用藍色底線、刪"]
[1969.364155, "o", "除用紅色刪除線。接下來我會改比對程式，套用這兩個樣式，並記錄每處修改的段落與原文片\r\u001b[2C\u001b[1B段，方便之後搜尋 PDF 找出實際頁碼。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mimport pathlib\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;241mp\u001b[8G=\u001b[10Gpathlib.Pat\u001b[22G(\"manuscript/style/mark_changes.py\"); s = p.read_text()\r\u001b[5C\u001b[1Bdef rep(a, b):\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mglobal s\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241massert s.count(a) == 1, a[:50]; s = s.replace(a, b)\r\u001b[5C\u001b[1Brep('''New text is wrapped as [text]{.underline}; deleted text as ~~text~~ (JCRP: \"mark the changes as underlined\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mor…\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1969.364934, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[12BSwitching\u001b[13Gmarks\u001b[19Gt\u001b[21G colored\u001b[30Gstyles\u001b[37Gand\u001b[41Grecording\u001b[51Gchanged\u001b[59Gparagraphs\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1969.393811, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[22B\u001b[38;5;216mSprouting…\u001b[25G\u001b[38;5;241m6\u001b[27G4\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1969.413242, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✢\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
