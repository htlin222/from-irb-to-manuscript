[1278.450565, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote \u001b[1m179\u001b[16G\u001b[22mlines to \u001b[1mmanuscript/references.yaml\u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  1 \u001b[22m\u001b[38;5;246m# 參考文獻清單（單一來源）。只手寫 DOI 與預期的第一作者／年份；書目內容一律由\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m\u001b[38;5;246m# manuscript/verify_references.py 從 Crossref 與 PubMed 取得並互相比對，產生 references.bib。\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  3 \u001b[22m\u001b[38;5;246m# 來源：OpenEvidence 查詢（2026-10-09；article id 見 found_via）。\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  4 \u001b[22m\u001b[38;5;246m# role：論文中用來支持什麼（給作者參考，引用前請讀原文摘要確認）。\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m- \u001b[38;5;31mkey:\u001b[38;5;236m \u001b[38;5;24mgianni2012neosphere\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[10G\u001b[22m  \u001b[38;5;31mdoi:\u001b[38;5;236m \u001b[38;5;31m10.1016\u001b[38;5;24m/S1470-2045(11)70336-9\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[10G\u001b[22m  \u001b[38;5;31mexpect:\u001b[38;5;"]
