[1830.165724, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1m寫作過程中順便修好的\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G括號裡又有括號的寫法：信賴區間在括號內時，改用方括號。\r\u001b[2C\u001b[1B- 1 到 10 的數字自動拼成英文，例如「three\u001b[45Gduplicate\u001b[55Grecords」。\r\u001b[4C\u001b[1B論文首頁的電話改成英文：\u001b[38;5;105mcv.toml\u001b[39m 裡新增了 \u001b[38;5;105mphone_en\u001b[39m，中文的\u001b[63GIRB\u001b[67G表單仍用原本的中文電話。\r\u001b[4C\u001b[1B分析程式加上了各年代的 pCR 人數，這是描述性的資料，分析方法不變。結果段引用的數字（例如\u001b[93G2016–2019\u001b[103G年\u001b[106G52.6%\u001b[112G對\r\u001b[2C\u001b[1B \u001b[5G44.7%）因此可以追溯到正式的分析結果。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m檢查與存檔\u001b[22m：檢查報告的待修正項目是 0。兩項請確認：「statistically\u001b[69Gsignificant」是正確的統計用語；「AI\r\u001b[2C\u001b[1B撰寫」是刻意保留的示範標示。139\u001b[35G項測試全部通過，所有變更已用\u001b[64Ggit\u001b[68Gcommit\u001b[75G存檔在\u001b[82G\u001b[38;5;105mmanuscript\u001b[93G\u001b[39m分支"]
[1830.165884, "o", "上。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m還沒做的部分\u001b[22m（JCRP 投稿時也需要，您要的話我接著做）：\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G補充資料：完整版\u001b[23GTable\u001b[29G1、平衡圖、次族群分析、E-value、分析程式。\r\u001b[2C\u001b[1B2. Cover letter 和\u001b[22GSTROBE 檢核表。\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G把這個版本打上標記，例如 \u001b[38;5;105mmanuscript-demo-v1\u001b[39m，並把各分支合併回主線。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GWorked for 8m 41s · done 9:07 AM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m照期刊格式產出投稿檔案。\u001b[39m                                                                                            \r\u001b[2B\u001b[49m\u001b[38;5;16m⏺\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1830.184647, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✳\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1830.197324, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✶\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
