[2440.260009, "o", "───────────────────────────┴─────────────────────────────────────────────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B第二輪決定信沒有寫交回期限。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m檢查結果\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G修訂版檢查全部通過，包括\u001b[30G9\u001b[32G處修改都找到頁碼。\r\u001b[4C\u001b[1B獨立檢查程式：\u001b[1m59/59 通過\u001b[22m。摘要 246 字（上限 250），正文\u001b[61G2,822\u001b[67G字（上限\u001b[76G4,000）。\r\u001b[4C\u001b[1B139 項測試、41 項分析定義測試、程式碼檢查都通過。\u001b[K\r\u001b[4C\u001b[1B結果檔記錄的都是已存檔的程式版本。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B這次也順便修好兩個程式問題：\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G段落開頭有刪改時，修改總覽會找不到頁碼。\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[2440.615185, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[20B-\u001b[5G段落開頭有刪改時，修改總覽會找不到頁碼。\r\u001b[4C\u001b[1B表格欄位標題會把單字拆開（例如 \"unweight\u001b[46G/\u001b[48Ged\"）。\r\u001b[2C\u001b[1B\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
