[1078.52809, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;5;174m✳\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1078.543168, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;5;174m✢\u001b[19G\u001b[38;5;241m5\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1078.548916, "o", "\u001b[?25l\u001b[H\u001b[3G3\u001b[6G執行 \u001b[38;5;105mmake analysis\u001b[39m，再把每個結果檔和存檔版本逐一比對。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B我還會多做一個更嚴格的測試：如果在另一台電腦上重跑，沒有我們的病歷號對照表，研究編號會重新隨機產生，結果還會一樣嗎？\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m原來是因為\u001b[14G\u001b[38;5;105mdata/raw/\u001b[24G\u001b[39m資料夾已存在且含有指紋清單，我建的連結被放錯位置導致找不到原始檔，而非資料本身有問題，驗證機制\r\u001b[1B \u001b[3G也確實正確攔下了這個錯誤。我會改為逐一連結每個原始檔，並用版本紀錄中的指紋清單來核對。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m乾淨重跑成功。現在把每個結果檔和存檔版本逐一比對。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;"]
[1078.549068, "o", "5;16m⏺\u001b[39m 9個機器可讀結果檔和PNG圖完全一致，差異僅在報告中的產生時間與版本編號，PDF/Word內容抽出比對後也確認相同。接下來我要做\r\u001b[2C\u001b[1B更嚴格的測試：模擬在另一台電腦重跑、研究編號全部重新隨機產生。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[25C\u001b[2B\u001b[38;5;241m3\u001b[28G3\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
