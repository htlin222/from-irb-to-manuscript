[1560.193413, "o", "236m, d, \u001b[38;5;24m\"f)\"\u001b[38;5;236m), \r\u001b[7C\u001b[1B\u001b[2m \u001b[10G\u001b[22mes\u001b[13G, lo, hi)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[10G\u001b[22mfm\u001b[13G_p \u001b[38;5;125m<-\u001b[19Gfunction\u001b[38;5;236m(p) \u001b[38;5;125mif\u001b[38;5;236m (p \u001b[38;5;125m>=\u001b[38;5;236m \u001b[38;5;31m0.001\u001b[38;5;236m) sprintf(\u001b[38;5;24m\"*P* = %.3f\"\u001b[38;5;236m, p) \u001b[38;5;125melse\u001b[38;5;236m sprintf(\u001b[38;5;24m\"*P* = %s\"\u001b[38;5;236m, formatC(p, form\r\u001b[7C\u001b[1B\u001b[2m9\u001b[14G\u001b[22mn_of\u001b[19G\u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(k,\u001b[34Gn)\u001b[37Gsprintf(\u001b[38;5;24m\"%d/%d (%.1f%%)\"\u001b[38;5;236m, k, n\u001b[69G\u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m k\u001b[77G\u001b[38;5;125m/\u001b[38;5;236m n)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[14G\u001b[22mmonth \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(d) format(as.Date(d), \u001b[38;5;24m\"%B \u001b[59GY\u001b[61G\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m… +88 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[39m 數字代號程式有個小錯誤（變數命名和資料欄位衝突），修正後重新"]
