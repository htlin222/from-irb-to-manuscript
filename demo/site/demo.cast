[1837.569258, "o", "51G        \r\u001b[6C\u001b[1B\u001b[38;5;29m12\u001b[11G\u001b[38;5;236mThank\u001b[17Gyou\u001b[21Gfor\u001b[25Gconsidering\u001b[37Gour\u001b[41Gmanuscript.\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m求職信、STROBE 對照表和題目代號都準備好了。接下來我會把 \u001b[38;5;105marticle.qmd\u001b[39m\u001b[K\r\u001b[2C\u001b[1B裡共用的排版功能（讀取段落、填入數字、排表格）抽出來放進 \u001b[38;5;105mrender_helpers.R\u001b[39m，讓所有文件共用同一套邏輯。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mExtracting shared render helpers from article.qmd\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mimport pathlib, re\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mart = pathlib.Path(\"manuscript/article.qmd\"); s = art.read_text()\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mm = re.search(r\"```\\{r load\\}\\n(.*?)\\n```\\n\", s, re.S)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241mbody = m.group(1)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mhelpers_start = body.index(\"section <- function(name) {\")\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mhelpers_end = body.index(\"tabs <- manuscript_tables()\")\r\u001b[1B\u001b[39m    "]
