[1259.987842, "o", "\u001b[?25l\u001b[H\u001b[3G- \u001b]8;id=1rc814h;https://www.airitilibrary.com/jnltitledo/P20140707002-n.pdf\u0007\u001b[34mJCRP 舊版投稿須知（airiti，已過時）\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2C\u001b[1B- \u001b]8;id=10qso06;https://portal.issn.org/resource/ISSN/2589-0425\u0007\u001b[34mISSN 2589-0425 期刊登錄資料\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[2B\u001b[38;5;241m✻\u001b[3GChurned for 2m 33s · done 8:27 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m❯ \u001b[38;5;16m用 OpenEvidence 幫我找討論要用的文獻，每一篇都要查證是真的。\u001b[39m                                                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m我會分兩步做，確保每一篇都是真的：\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1m用 OpenEvidence 找文獻\u001b[22m：依討論段落會用到的主題分四組問題。\r\u001b[1B  2. \u001b[1m自己獨立查證\u001b[22m：不只相信 OpenEvidence 給的引用，每一篇都直接去 PubMed 和 Crossref\u001b[K\r\u001b[5C\u001b[1B的官方資料庫比對，確認作者、標題、期刊、年份、PMID\u001b[57G和\u001b[60GDOI\u001b[64G全部吻合。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B四組問題同"]
[1259.987999, "o", "時送出：\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mCalled openevidence \u001b[1m4\u001b[22m times \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m已取得約30篇文獻，但缺少NeoSphere主報告、PEONY主報告、CTNeoBC、APHINITY、Li\r\u001b[2C\u001b[1B2018原始論文及多重插補合併傾向分數方法論文獻等關鍵文獻，我再針對這幾篇補問一次。\r\u001b[22C\u001b[2B…\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
