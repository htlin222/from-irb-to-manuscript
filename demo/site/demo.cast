[945.576927, "o", "\u001b[?25l\u001b[H\r\u001b[13B \u001b[3G\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m差異規律很明確：沒用到隨機步驟的分析結果完全一致，有多重插補的分析僅小數點第二位有跳動，配對分析（S2）跳動最大，稍後\r\u001b[2C\u001b[1B會說明原因。現在我先清除測試用的副本，特別是測試2產生、含病歷號的新對照表，不能留在暫存區。\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[30C\u001b[2B\u001b[38;5;241m9\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[945.594513, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m乾淨重跑成功。現在把每個結果檔和存檔版本逐一比對。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m9個機器可讀結果檔和PNG圖完全一致，差異僅在報告中的產生時間與版本編號，PDF/Word內容抽出比對後也確認相同。接下來我要做\r\u001b[2C\u001b[1B更嚴格的測試：模擬在另一台電腦重跑、研究編號全部重新隨機產生。\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m差異規律很明確：沒用到隨機步驟的分析結果完全一致，有多重插補的分析僅小數點第二位有跳動，配對分析（S2）跳動最大，稍後\r\u001b[2C\u001b[1B會說明原因。現在我先清除測試用的副本，特別是測試2產生、含病歷號的新對照表，不能留在暫存區。\r\u001b[2B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRemoving test worktrees"]
