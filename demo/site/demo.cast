[1422.152795, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m 4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  5 \u001b[22mword_count \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(x) {\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m  x \u001b[38;5;125m<-\u001b[38;5;236m gsub(\u001b[38;5;24m\"<!--.*?-->\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m, x)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  7 \u001b[22m  x \u001b[38;5;125m<-\u001b[38;5;236m gsub(\u001b[38;5;24m\"\\\\[@[^]]*\\\\]\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m, x)                         \u001b[38;5;246m# 引用\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  8 \u001b[22m  x \u001b[38;5;125m<-\u001b[38;5;236m gsub(\u001b[38;5;24m\"(?m)^#+ .*$\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m, x, perl \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mTRUE\u001b[38;5;236m)             \u001b[38;5;246m# 小標題不計\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m  x \u001b[38;5;125m<-\u001b[38;5;236m gsub(\u001b[38;5;24m\"[*_`#>]\"\u001b[38;5;236m, \u001b[38;5;24m\" \"\u001b[38;5;236m, x)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 10 \u001b[22m  \u001b[38;5;31mlength\u001b[38;5;236m(Filter(\u001b[38;5;31mnzchar\u001b[38;5;236m, strsplit(trimws(x), \u001b[38;5;24m\"\\\\s+\"\u001b[38;5;236m)[[\u001b[38;5;31m1\u001b[38;5;236m]]))\r\u001b[1B\u001b[39m   "]
