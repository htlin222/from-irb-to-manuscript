[1484.222188, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;160m\u001b[48;5;224m45\u001b[11G\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x,\u001b[48Gpart\u001b[53G=\u001b[55G\"body\")$widths,\u001b[71G0.6)\u001b[78G#\u001b[80G依內容（不依長標題）決定欄寬；標\r\u001b[6C\u001b[1B\u001b[38;5;160m  \u001b[11G\u001b[38;5;236m題自動換行         \u001b[31G    \r\u001b[5C\u001b[1B\u001b[38;5;160m 46 -\u001b[38;5;236m  w[1] <- max(w[1], 1.8)                                                                             \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m45\u001b[11G\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x,\u001b[48Gpart\u001b[53G=\u001b[55G\"body\")$widths,\u001b[71G0.6)\u001b[48;5;157m + 0.12\u001b[85G\u001b[48;5;194m#\u001b[87G依內容（不依長標題）\u001b[48;5;157m決定\r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  \u001b[11G\u001b[38;5;236m\u001b[48;5;157m欄寬並留緩衝\u001b[48;5;194m；標題自動換行        \r\u001b[5C\u001b[1B\u001b[38;5;29m 46 +\u001b[38;5;236m  w[1] <- \u001b[48;5;157mmin(\u001b[48;5;194mmax(w[1], 1.\u001b[48;5;157m5\u001b[48;5;194m)\u001b[48;5;157m, 2.2)\u001b[48;5;194m                                                                   \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[11G\u001b[22m  flextable::width(x, width = w * min(1, page / sum(w)))\r\u001b[7C"]
