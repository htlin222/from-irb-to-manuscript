[1666.77216, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m 45 -\u001b[38;5;236m  w <- flextable::dim_pretty(x)$widths                                                               \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 45 +\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x, part = \"body\")$widths, 0.6)   # 依內容（不依長標題）決定欄寬；標\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236m題自動換行                                                                                           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[11G\u001b[22m  w[1] <- max(w[1], 1.8)\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m \u001b[13Gflextable::width(x, width =\u001b[41Gw * min(1, page / sum(w)))\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m48\u001b[11G\u001b[22m}\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39mTable 3 現在清楚易讀，但 Table 2\u001b[36G欄位較多，數字仍會被擠到斷行。我會把這類多欄表格的字縮小到\u001b[95G9\r\u001b[2C\u001b[1B號並留出緩衝寬度，同時稍微縮窄第一欄讓"]
