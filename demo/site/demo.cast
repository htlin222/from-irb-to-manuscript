[930.598262, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;241m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 74 \u001b[22m       }\r\u001b[7C\u001b[1B\u001b[2m5\u001b[15G\u001b[22m}\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[13G\u001b[22m}\u001b[15G\u001b[38;5;125melse\u001b[38;5;236m \u001b[38;5;125mif\u001b[38;5;236m (method \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"match\"\u001b[38;5;236m) {\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 74 -\u001b[38;5;236m    m <- matchit(f, data = x, method = \"nearest\", caliper = 0.2, std.caliper = TRUE)                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 77 +\u001b[38;5;236m    \u001b[38;5;246m# 單標靶人數少於雙標靶，部分雙標靶病人必然配不到對（MatchIt 會警告，屬預期）\u001b[38;5;236m                     \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[15G\u001b[38;5;236mm \u001b[38;5;125m<-\u001b[38;5;236m suppressWarnings(matchit(f, data \u001b[38;5;125m=\u001b[38;5;236m x, method \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"nearest\"\u001b[38;5;236m, caliper \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m0.2\u001b[38;5;236m,\u001b[93Gstd.caliper\u001b[105G\u001b[38;5;125m=\u001b[107G\u001b[38;5;31mTRUE\u001b[38;5;236m)\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m)\u001b[15G \u001b[17G                                                  "]
[930.598419, "o", "                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 79 \u001b[22m     md \u001b[38;5;125m<-\u001b[38;5;236m as.data.table(match.data(m))\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m80\u001b[15G\u001b[22mout\u001b[38;5;125m$\u001b[38;5;236mn\u001b[21G\u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;31msum\u001b[38;5;236m(md\u001b[38;5;125m$\u001b[38;5;236mdual \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;31m0\u001b[38;5;236m), \u001b[38;5;31msum\u001b[38;5;236m(md\u001b[38;5;125m$\u001b[38;5;236mdual \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;31m1\u001b[38;5;236m)); out\u001b[38;5;125m$\u001b[38;5;236mess \u001b[38;5;125m<-\u001b[38;5;236m out\u001b[38;5;125m$\u001b[38;5;236mn\r\u001b[7C\u001b[1B\u001b[2m1\u001b[15G\u001b[22mg_or \u001b[38;5;125m<-\u001b[38;5;236m glm(reformul\u001b[36Gte(\u001b[38;5;24m\"dual\"\u001b[38;5;236m, outcome),\u001b[57Gdata \u001b[38;5;125m=\u001b[38;5;236m md, family \u001b[38;5;125m=\u001b[38;5;236m quasibinomial, weights \u001b[38;5;125m=\u001b[38;5;236m weights)\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m合併多重插補結果時出現缺值，代表某一個分析算出了空的估計值。我把各分析拆開檢查，找出是哪一個。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38"]
