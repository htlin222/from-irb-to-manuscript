[1488.826598, "o", "│\u001b[6G                       │ 2013）、PEONY 亞洲試驗（Shao 2020）與最終分析（Huang 2024）                      \u001b[115G│\r\u001b[2C\u001b[1B├─────────────────────────┼─────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G\u001b[1mpCR 和長期預後的關係\u001b[22m    │ CTNeoBC 合併分析（Cortazar 2014）                                                \u001b[115G│\r\u001b[2C\u001b[1B├─────────────────────────┼─────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G\u001b[1mpertuzumab \u001b["]
[1488.826623, "o", "22m             │ APHINITY（von\u001b[45GMinckwitz\u001b[55G2017；Loibl\u001b[67G2024，8.4\u001b[77G年追蹤）\u001b[115G│\r\u001b[2C\u001b[1B│\u001b[5G\u001b[1m的長期效益不大\u001b[22m  \u001b[29G│\u001b[115G│\r\u001b[1B  ├─────────────────────────┼─────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[29G│\u001b[31G土耳其多中心（Bilici\u001b[52G2023）、義大利（Fabbri\u001b[75G2023）、中國（Cheng\u001b[115G│\r\u001b[1B \u001b[3G│ \u001b[1m和其他真實世界研究比較\u001b[22m \u001b[29G│ 2022）、西班牙（Díaz-Redondo 2019）、美國單一機構（Spring                     \u001b[110G     │\r\u001b[2C\u001b[1B│       \u001b[12G        \u001b[21G        │ 2018）、真實世界研究的統合分析（Matsas\u001b[70G2026，18\u001b[79G篇研究，pCR\u001b[91G勝算比\u001b[98G1.81）\u001b[115G│\r\u001b[2C\u001b[1B├─────────"]
[1488.827952, "o", "────────────────┼─────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[1B \u001b[3G│ \u001b[1m解釋 EFS 受年代影響\u001b[22m     │ KATHERINE：術後 T-DM1（von\u001b[58GMinckwitz\u001b[68G2019；Geyer\u001b[80G2025\u001b[85G整體存活）\u001b[115G│\r\u001b[1B  ├─────────────────────────┼─────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G\u001b[1m殘留病灶和 ypN0(i+) \u001b[22m    │ RCB（Yau 2022）、Wong 2019、Montagna 2025           \u001b[115G│\r\u001b[2C\u001b[1B│\u001b[5G\u001b[1m的預後\u001b[22m                  │                                   "]
