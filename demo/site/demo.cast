[816.845278, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 79 \u001b[22m     md \u001b[38;5;125m<-\u001b[38;5;236m as.data.table(match.data(m))\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m80\u001b[15G\u001b[22mout\u001b[38;5;125m$\u001b[38;5;236mn\u001b[21G\u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;31msum\u001b[38;5;236m(md\u001b[38;5;125m$\u001b[38;5;236mdual \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;31m0\u001b[38;5;236m), \u001b[38;5;31msum\u001b[38;5;236m(md\u001b[38;5;125m$\u001b[38;5;236mdual \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;31m1\u001b[38;5;236m)); out\u001b[38;5;125m$\u001b[38;5;236mess \u001b[38;5;125m<-\u001b[38;5;236m out\u001b[38;5;125m$\u001b[38;5;236mn\r\u001b[7C\u001b[1B\u001b[2m1\u001b[15G\u001b[22mg_or \u001b[38;5;125m<-\u001b[38;5;236m glm(reformul\u001b[36Gte(\u001b[38;5;24m\"dual\"\u001b[38;5;236m, outcome),\u001b[57Gdata \u001b[38;5;125m=\u001b[38;5;236m md, family \u001b[38;5;125m=\u001b[38;5;236m quasibinomial, weights \u001b[38;5;125m=\u001b[38;5;236m weights)\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m合併多重插補結果時出現缺值，代表某一個分析算出了空的估計值。我把各分析拆開檢查，找出是哪一個。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell com"]
[816.845434, "o", "mands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m找到了：「傳統多變項迴歸」（敏感度分析\u001b[42GS3）的公式寫錯，把治療組這個變項漏掉了，所以算不出治療效果。我把它補回去。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mIncluding\u001b[13Gtreatment\u001b[23Gin\u001b[26Gregression\u001b[37Gmodels\u001b[44Gand\u001b[48Grerunning\u001b[38;5;241m · 2s\r\u001b[1B  ⎿  $ python3 - <<'EOF'\u001b[26G\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;241mim\u001b[9Gort pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp = pathlib.Path(\"analysis/R/outcomes.R\"); s = p.read_text()\r\u001b[5C\u001b[1Bfor\u001b[10Ga, b \u001b[16Gn [\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m(' g <- glm(update(f, as.formula(paste(outcome, \"~ .\"))), data = x, family = binomial)',\r\u001b[5C\u001b[1B' g <- glm(update(f, as.formula(paste(outcome, \"~ dual + .\"))), data = x, family = binomial)'),\r\u001b[5C\u001b[1B(' c… (3s)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;241mctrl+b ctrl+b (twice) to run in background)\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
