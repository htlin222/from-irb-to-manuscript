[1585.358695, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=7iwlnu;file:///Users/Shared/her2-neoadjuvant-study/manuscript/R/tokens.R\u0007manuscript/R/tokens.R\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m 49 \u001b[22m     pcr_crude_dual \u001b[38;5;125m=\u001b[38;5;236m fmt_n_of(d1(\u001b[38;5;24m\"pcr_n\"\u001b[38;5;236m, \u001b[38;5;24m\"dual\"\u001b[38;5;236m), d1(\u001b[38;5;24m\"n\"\u001b[38;5;236m, \u001b[38;5;24m\"dual\"\u001b[38;5;236m)),\r\u001b[5C\u001b[1B\u001b[2m 50 \u001b[22m     pcr_crude_single \u001b[38;5;125m=\u001b[38;5;236m fmt_n_of(d1(\u001b[38;5;24m\"pcr_n\"\u001b[38;5;236m, \u001b[38;5;24m\"single\"\u001b[38;5;236m), d1(\u001b[38;5;24m\"n\"\u001b[38;5;236m, \u001b[38;5;24m\"single\"\u001b[38;5;236m)),\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 51 \u001b[22m     pcr_w_dual \u001b[38;5;125m=\u001b[38;5;236m fmt_pct(P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mpcr_dual), pcr_w_single \u001b[38;5;125m=\u001b[38;5;236m fmt_pct(P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mpcr_single),\r\u001b[1B\u001b[39m     \u001b[38;5;160m\u001b[48;5;224m 52 -\u001b[38;5;236m    pcr_rd = sprintf(\"%.1f"]
[1585.359024, "o", " percentage points (95%% CI, %.1f–%.1f)\", 100 * P(\"main\")$rd, 100 * P(\"main\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m\")$rd_lo,                                                                                            \r\u001b[5C\u001b[1B\u001b[38;5;160m 53 -\u001b[38;5;236m                     100 * P(\"main\")$rd_hi),                                                         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 52 +\u001b[38;5;236m    pcr_rd \u001b[38;5;125m=\u001b[38;5;236m sprintf(\u001b[38;5;24m\"%.1f percentage points (95%% CI, %\u001b[48;5;157ms\u001b[48;5;194m)\"\u001b[38;5;236m, \u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mrd,                     \r\u001b[5C\u001b[1B\u001b[38;5;29m 53 +\u001b[38;5;236m                     \u001b[48;5;157mci_range(\u001b[38;5;31m\u001b[48;5;194m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236m\u001b[48;5;157mrd_lo, \u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236m\u001b[48;5;194mrd_hi\u001b[48;5;157m, \u001b[38;5;31m1\u001b[38;5;236m\u001b[48;5;194m)\u001b[4"]
[1585.359329, "o", "8;5;157m)\u001b[48;5;194m,                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 54 \u001b[22m     pcr_or \u001b[38;5;125m=\u001b[38;5;236m fmt_ci(P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mor, P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mor_lo, P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mor_hi), pcr_p \u001b[38;5;125m=\u001b[38;5;236m fmt_p(P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mp),\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 55 \u001b[22m     evalue_pcr \u001b[38;5;125m=\u001b[38;5;236m sprintf(\u001b[38;5;24m\"%.2f\"\u001b[38;5;236m, ev[endpoint \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"pCR (OR)\"\u001b[38;5;236m, point]),\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 56 \u001b[22m     evalue_pcr_ci \u001b[38;5;125m=\u001b[38;5;236m sprintf(\u001b[38;5;24m\"%.2f\"\u001b[38;5;236m, ev[endpoint \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"pCR (OR)\"\u001b[38;5;236m, lower]),\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m接下來我會處理 \u001b[38;5;105marticle.qmd\u001b[39m，這是論文組裝的主檔，負責整合各段文字、數字、表格、圖說與參考文獻，最終輸出成符合\u001b[112GJCRP\r\u001b[2C\u001b[1B格式的"]
