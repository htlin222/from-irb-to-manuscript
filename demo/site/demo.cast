[2077.759171, "o", "式仍嘗試計算\u001b[73GEFS\u001b[77G事件數而出錯。我已改成只在有\u001b[106GEFS\r\u001b[1B \u001b[3G欄位時才計算，主分析結果不受影響。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mMaking\u001b[10Gevent\u001b[16Gcounting\u001b[25Gconditional\u001b[37Gand\u001b[41Grerunning\u001b[51Gpost\u001b[56Ghoc\u001b[60Ganalyses\u001b[38;5;241m · 2s\r\u001b[1B  ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;241mim\u001b[9Gort pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp = pathlib.Path(\"analysis/R/estimation.R\"); s = p.read_text()\r\u001b[5C\u001b[1Ba\u001b[10G\" if (is.null(out$events)) out$eve\u001b[45Gts <-\u001b[51Gevents(x)\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;241mssert s.count(a) == 1\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp.wri\u001b[12Ge_text(s.replace(a, ' if (is.null(out$events) && \"efs_event\" %in% names(x)) out$events <- events(x) # 只有 \r\u001b[6C\u001b[1BCR 的資料集不算事… (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m(ctrl+b ctrl+b (twice) to run in background)\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
