[1292.256481, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m94\u001b[11G\u001b[22mcat(sprintf(\u001b[24G\u001b[38;5;24m\\n查證：%d 篇；通過 %d、需人工確認 %d、失敗 %d\\n\"\u001b[38;5;236m, nrow(res), res[grepl(\u001b[38;5;24m\"^verified\"\u001b[38;5;236m, sta\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22mtus), .N],\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m95\u001b[11G\u001b[22m \u001b[13G   \u001b[17G      res[status \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"CHECK\"\u001b[38;5;236m, .N], res[status \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"FAIL\"\u001b[38;5;236m, .N]))\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m29\u001b[6G篇全部找得到，沒有任何一篇失敗；26 篇兩個資料庫完全吻合，另外 3 篇需要人工確認。我看一下這 3 篇是哪裡不一致。\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m三篇文獻都查核確認為真，差異出自資料庫登記方式（副標題分離、線上搶先版 vs 正式版），並發現\u001b[94GOpenEvidence\r\u001b[1B  誤給了一個心臟科論文的\u001b[26GPMID（但我們程式用\u001b[4"]
[1292.256604, "o", "5GDOI\u001b[49G查得正確號碼未受影響）。我已強化查證程式：合併標題副標題、以\u001b[110GPubMed\r\u001b[2C\u001b[1B為作者依據、卷期頁碼僅在雙方皆有資料時比對。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRefine\u001b[10Gverification\u001b[23Grules\u001b[29Gand\u001b[33Grerun\u001b[39Greference\u001b[49Gchecks\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 - <<'EOF'\r\u001b[5C\u001b[1Bimport pathlib\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mp = pathlib.Path(\"manuscript/verify_references.R\"); s = p.read_text()\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241mpairs = [\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241m(''' list(title = strip_tags(unlist(m$title)[1] %||% \"\"), journal''',\r\u001b[5C\u001b[1B''' sub_t <- unlist(m$subtitle)[1] %||% \"\" # Crossref 把副標題另外登記\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mlist(title = strip_tags(paste0(unlist(m$title)[1] %…\r\u001b[2C\u001b[2B\u001b[38;5;216mCoalescing…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1292.282954, "o", "\u001b[?25l\u001b[H\r\u001b[13B\u001b[38;5;241m⏺\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1292.359453, "o", "\u001b[?25l\u001b[H\r\u001b[13B\u001b[38;5;241m \u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1292.436003, "o", "\u001b[?25l\u001b[H\r\u001b[13B\u001b[38;5;241m⏺\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
