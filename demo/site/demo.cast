[1538.852287, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✽\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1538.860029, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m命令列的引號跳脫出了問題。我改成把程式寫進檔案再執行。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m作者名單太長，摘要的結果段被截掉了。我改成只擷取每篇摘要的「結果」和「結論」段落。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m大部分摘要數字已核對一致，但\u001b[32GPEONY\u001b[38G最終分析和\u001b[49GAPHINITY\r\u001b[2C\u001b[1B這兩篇因摘要格式不同，尚未抓到結果段，接下來我補抓這兩篇資料。\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39mAPHINITY\u001b[12G核對到了：8\u001b[24G年整體存活\u001b[35G92.7%\u001b[41G對\u001b[44G92.0%，風險比\u001b[58G0.83，\u001b[1m沒有改善整體存活\u001b[22m。PEONY\r\u001b[2C\u001b[1B最終分析那篇抓到的是摘要的結尾，我再往前抓摘要的主體。\r\u001b[2B\u001b[38;5;241m⏺\u001b[3"]
