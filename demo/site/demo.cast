[1991.107067, "o", "成依論文段落順\u001b[59G排列，並讓每處修改都從論文第一頁重新開始搜尋。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mOrder\u001b[9Gchanges\u001b[17Gby\u001b[20Gdocument\u001b[29Gand\u001b[33Gsearch\u001b[40Gfrom\u001b[45Garticle\u001b[53Gstart\u001b[38;5;241m · 3s\r\u001b[1C\u001b[1B ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;241mim\u001b[9Gort pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp = pathlib.Path(\"manuscript/R/build_revision.R\"); s = p.read_text()\r\u001b[5C\u001b[1Bfor\u001b[10Ga, b \u001b[16Gn [\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m('''changes\u001b[18G<- rbindlist(jsonlite::read_json(file.path(REV, \"marked\", \"changes.json\")))\r\u001b[5C\u001b[1BSECTION_LABELS\u001b[21G<- c(ab\u001b[30Gract = \"Abstr\u001b[44Gct\", introduction = \"Introduction\", method\u001b[87G = \"Material… (3s)\r\u001b[5C\u001b[1B(ctrl+b ctrl+b\u001b[21G(twice) \u001b[30Go run in \u001b[40Gackground)\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
