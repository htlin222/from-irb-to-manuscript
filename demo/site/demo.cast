[888.597484, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✻\u001b[8G\u001b[38;5;216mi\u001b[11G\u001b[38;5;174m…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[888.829744, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✽\u001b[7G\u001b[38;5;216mv\u001b[10G\u001b[38;5;174mg\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
