[1670.460966, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;160m\u001b[48;5;224m45\u001b[11G\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x,\u001b[48Gpart\u001b[53G=\u001b[55G\"body\")$widths,\u001b[71G0.6)\u001b[78G#\u001b[80G依內容（不依長標題）決定欄寬；標\r\u001b[6C\u001b[1B\u001b[38;5;160m  \u001b[11G\u001b[38;5;236m題自動換行         \u001b[31G    \r\u001b[5C\u001b[1B\u001b[38;5;160m 46 -\u001b[38;5;236m  w[1] <- max(w[1], 1.8)                                                                             \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m45\u001b[11G\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x,\u001b[48Gpart\u001b[53G=\u001b[55G\"body\")$widths,\u001b[71G0.6)\u001b[48;5;157m + 0.12\u001b[85G\u001b[48;5;194m#\u001b[87G依內容（不依長標題）\u001b[48;5;157m決定\r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  \u001b[11G\u001b[38;5;236m\u001b[48;5;157m欄寬並留緩衝\u001b[48;5;194m；標題自動換行        \r\u001b[5C\u001b[1B\u001b[38;5;29m 46 +\u001b[38;5;236m  w[1] <- \u001b[48;5;157mmin(\u001b[48;5;194mmax(w[1], 1.\u001b[48;5;157m5\u001b[48;5;194m)\u001b[48;5;157m, 2.2)\u001b[48;5;194m                                                                   \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[11G\u001b[22m  flextable::width(x, width = w * min(1, page / sum(w)))\r\u001b[7C"]
[1670.461117, "o", "\u001b[1B\u001b[2m8\u001b[11G\u001b[22m}\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m49\u001b[11G\u001b[22mfootnotes <- function(t) knitr::asis_output(paste0(\"\\n\", paste(t$footnotes, collapse = \"\\n\\n\"), \"\\n\")\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m    \u001b[22m )\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m三張表現在都清楚易讀了，Table 2\u001b[K\r\u001b[2C\u001b[1B的信賴區間偶爾分成兩行是可接受的。接下來我會跑全部測試和程式碼檢查，確認寫作指引裡的數字正確後存檔。\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running tests, linting, and sanity-check the writing guide\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ make test \u001b[19G>&1 | tail -1; make test-analysis 2>&1 | grep definitions; make\u001b[83Glint\u001b[88G2>&1 | tail -2; grep -o '2.01 \r\u001b[5C\u001b[1B(95% CI, 1.12–3.62)' ma\u001b[30Guscr\u001b[35Gpt/_build/writing_guide.html | head\u001b[71G-1; grep -c '{{' \r\u001b[5C\u001b[1Bmanuscrip\u001b[16G/_build/writing_g\u001b[34Gide.html; git status --short\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
