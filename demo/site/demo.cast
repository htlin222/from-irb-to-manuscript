[1844.20258, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1hwojb5;file:///Users/Shared/her2-neoadjuvant-study/analysis/R/posthoc_revision1.R\u0007analysis/R/posthoc_revision1.R\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote \u001b[1m119\u001b[22m lines to \u001b[1manalysis/R/posthoc_revision1.R\u001b[22m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m 1\u001b[10G\u001b[22m\u001b[38;5;246m# 事後分析（post hoc）：回應 JCRP 第一輪審查意見。不在 SAP v1.0 內，論文與決定紀錄須標明 post hoc。\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m\u001b[38;5;246m# 方法與主分析相同（同一份多重插補、重疊加權、Rubin 合併；analysis/R/estimation.R）。\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  3 \u001b[22m\u001b[38;5;246m# 輸出：results/posthoc_r1.csv（效應值）、posthoc_r1_overlap.csv（傾向分數重疊）、posthoc_r1_timing.cs\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  4 \u001b[22m\u001b[38;5;246m#       results/figures/ps_overlap.{pdf,png}\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22msource(\u001b[38;5;24m\"analysis/R/estimation.R\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b"]
[1844.202744, "o", "[22msuppressPackageStartupMessages(library(splines))\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[10G\u001b[22mings \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mNULL\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[10G\u001b[22mc\u001b[12G \u001b[38;5;125m<-\u001b[38;5;236m rd(\u001b[38;5;24m\"cohort\"\u001b[38;5;236m); su \u001b[38;5;125m<-\u001b[38;5;236m rd(\u001b[38;5;24m\"surgery\"\u001b[38;5;236m); fu \u001b[38;5;125m<-\u001b[38;5;236m rd(\u001b[38;5;24m\"followup\"\u001b[38;5;236m); reg \u001b[38;5;125m<-\u001b[38;5;236m unique(rd(\u001b[38;5;24m\"registry\"\u001b[38;5;236m))\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22mpbs_id\u001b[17G \u001b[38;5;125m<-\u001b[38;5;236m fu[recu\u001b[29Grenc\u001b[34G_typ\u001b[39G \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"Progression before surgery\"\u001b[38;5;236m \u001b[38;5;125m&\u001b[38;5;236m \u001b[38;5;125m!\u001b[38;5;236mstudy_id \u001b[38;5;125m%in%\u001b[38;5;236m su\u001b[38;5;125m$\u001b[38;5;236mstudy_id, study_id]\r\u001b[5C\u001b[1B\u001b[38;5;241m… +136 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m問題出在「他院手術病人」分析：這批資料沒有\u001b[46GEFS\u001b[50G"]
