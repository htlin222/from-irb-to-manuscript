[1482.185692, "o", "；標\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m題自動換行                                                                                           \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m 46 -\u001b[38;5;236m  w[1] <- max(w[1], 1.8)                                                                             \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;29m\u001b[48;5;194m 45 +\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x, part = \"body\")$widths, 0.6)\u001b[48;5;157m + 0.12\u001b[48;5;194m   # 依內容（不依長標題）\u001b[48;5;157m決定\u001b[48;5;194m \r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m\u001b[48;5;157m欄寬並留緩衝\u001b[48;5;194m；標題自動換行                                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 46 +\u001b[38;5;236m  w[1] <- \u001b[48;5;157mmin(\u001b[48;5;194mmax(w[1], 1.\u001b[48;5;157m5\u001b[48;5;194m)\u001b[48;5;157m, 2.2)\u001b[48;5;194m                                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 47 \u001b[22m   flextable::width(x, width = w * min(1, page / sum(w)))\r\u001b[5C\u001b[1B\u001b[2m 48 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38"]
[1482.185853, "o", ";5;236m\u001b[2m 49 \u001b[22m footnotes <- function(t) knitr::asis_output(paste0(\"\\n\", paste(t$footnotes, collapse = \"\\n\\n\"), \"\\n\")\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m )\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[7Gtimeout 10m)\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;174m✳\u001b[3G\u001b[38;5;216mGarnishing…\u001b[20G\u001b[38;5;241m16s · ↓\u001b[39m \u001b[38;5;241m88.3k tokens)\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
