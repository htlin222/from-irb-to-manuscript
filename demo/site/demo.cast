[2124.283382, "o", "\u001b[?25l\u001b[H     Execution\u001b[16Ghalted\r\u001b[5C\u001b[1B\u001b[2m… +5 lines\u001b[22m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mUpdated \u001b[1mmanuscript/R/render_helpers.R\u001b[44G\u001b[22m\u001b[38;5;241m(+1 -1)\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 49 \u001b[22m }\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 50 \u001b[22m footnotes \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(t) {\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m51\u001b[11G\u001b[22m  marked \u001b[38;5;125m<-\u001b[38;5;236m unlist(table_marks(t)\u001b[38;5;125m$\u001b[38;5;236mnew_footnotes)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 52 -\u001b[38;5;236m  fn <- vapply(t$footnotes, function(x) if (any(startsWith(x, marked))) sprintf('[%s]{custom-style=\"I\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnserted Text\"}', x) else x, \"\")                                                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 52 +\u001b[38;5;236m  fn \u001b[38;5;125m<-\u001b[38;5;236m vapply(t\u001b[38;5;125m$\u001b[38;5;236mfootnotes, \u001b[38;5;125mfunction\u001b[38;5;236m(x) \u001b[38;5;125mif\u001b[38;5;236m (\u001b[38;5;31m\u001b[48;5;157mlength\u001b[38;5;236m(marked) \u001b[38;5;125m&&\u001b[38;5;236m \u001b[38;5;31m\u001b[48;5;194many\u001b[38;5;236m(star"]
[2124.283536, "o", "tsWith(x, \u001b[38;5;31m\u001b[48;5;157mas.character\u001b[38;5;236m(\u001b[48;5;194mmarked))\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m)\u001b[48;5;157m)\u001b[48;5;194m sprintf(\u001b[38;5;24m'[%s]{custom-style=\"Inserted Text\"}'\u001b[38;5;236m, x) \u001b[38;5;125melse\u001b[38;5;236m x, \u001b[38;5;24m\"\"\u001b[38;5;236m)                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 53 \u001b[22m   knitr\u001b[38;5;125m::\u001b[38;5;236masis_output(paste0(\u001b[38;5;24m\"\\n\"\u001b[38;5;236m, paste(fn, collapse \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"\\n\\n\"\u001b[38;5;236m), \u001b[38;5;24m\"\\n\"\u001b[38;5;236m))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 54 \u001b[22m }\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[38;5;241mSearched for \u001b[1m3\u001b[22m patterns, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2B\u001b[38;5;16m⏺\u001b[3G\u001b[39m發現兩個問題：git 裡標記和分支同名（都叫\u001b[44G\u001b[38;5;105mjcrp-revision-1\u001b[39m），以及一個帶括號的設定值沒加引號導致指令出錯。我正在修正，\r\u001b[1B  讓程式明確讀取標記那一份，並補"]
