[1536.55662, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✶\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1536.567702, "o", "\u001b[?25l\u001b[H\r\u001b[16B\u001b[38;5;241m⏺\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1536.583752, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✻\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1536.598644, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✽\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1536.603606, "o", "\u001b[?25l\u001b[H\r\u001b[89C\u001b[19B\u001b[38;5;241m5\u001b[95G3\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1536.611856, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B動筆前要先做兩件事：\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1m核對文獻數字\u001b[22m：討論段會引用別人論文的數字，例如 NeoSphere\u001b[63G的\u001b[66GpCR\u001b[70G比例。我先從\u001b[83GPubMed\r\u001b[2C\u001b[1B  \u001b[6G下載這些論文的摘要，逐一核對，不用\u001b[41GOpenEvidence\u001b[54G的轉述。\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1m補上各年代的 pCR \u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[1m人數\u001b[22m：討論段要說明「每個年代內雙標靶都比較好」。這需要正式的數字，所以要加進分析程式，不能只用先前試算的結果。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B先核對文獻：\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m命令列的引號跳脫出了問題。我改成把程式寫進檔案再執行。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m作者名單太長，摘要的結果段被截掉了。我改成只擷取每篇摘要的「結果」和「結論」段落。\r\u001b[1B\u001b[K\r\u001b[1"]
[1536.611996, "o", "B\u001b[38;5;241m⏺\u001b[39m Extracting the results sections of the abstracts\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ sed\u001b[12G-i\u001b[15G'' 's/\u001b[22Gcat(\u001b[27G\\\\n=====\", ids$citation_key\\[i\\], ids$pmid\\[i\\], \"\\\\n\", substr(gsub(\"\\[\\[:space:\\]\\]+\", \" \",\r\u001b[5C\u001b[1Btx\u001b[9G), 1, 2000)\u001b[22G\"\\\\n\")/ \u001b[31Gxt <- gsub(\"[[:space:]]+\", \" \", txt);\u001b[69Gk <- regexpr(\"(FINDINGS|RESULTS):\", txt); \r\u001b[5C\u001b[1Bca\u001b[9G(\"\\\\n=====\", ids$citation_key[i], \"\\\\n\", substr(txt, k, k + 1500), \"\\\\n\")/' \"…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
