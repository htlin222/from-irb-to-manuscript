[1469.842755, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 89 \u001b[22m fwrite(res, \u001b[38;5;24m\"manuscript/references_verification.csv\"\u001b[38;5;236m)\r\u001b[6C\u001b[1B\u001b[2m90\u001b[11G\u001b[22mwriteLin\u001b[21G(\u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"% 由 manuscript/verify_\u001b[49Ge\u001b[51Gerences\u001b[59GR 自動產生（書目取自 Crossref / PubMed），請勿手改。\"\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m  \u001b[11G\u001b[22m, \u001b[38;5;24m\"\"\u001b[38;5;236m, bib),\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m91\u001b[11G\u001b[22m \u001b[13G   \u001b[17G     \u001b[38;5;24m\"manuscript/references.bib\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 92 -\u001b[38;5;236mprint(res[, .(key, status, pmid, year, journal, sim = title_similarity)], nrows = 100)               \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 92 +\u001b[38;5;236mprint(res[, .(\u001b[48;5;157mcitation_key\u001b[48;5;194m, status, pmid, year, journal, sim \u001b[38;5;125m=\u001b[38;5;236m title_similarity)], nrows \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m100\u001b[38;5;236m)      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 93 \u001b[22m n_bad \u001b[38;5;125m<-\u001b[38;5;236m res[status \u001b[38;5;125m%in%\u001b[38;5;236m \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"FAIL\"\u001b[38;5;236m, \u001b[38;5;24m\"C"]
[1469.842892, "o", "HECK\"\u001b[38;5;236m), .N]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[11G\u001b[22mcat(sprintf(\u001b[38;5;24m\"\\n查證：%d 篇；通過 %d、需人工確認 %d、失敗 %d\\n\"\u001b[38;5;236m, nrow(res), res[grepl(\u001b[38;5;24m\"^verified\"\u001b[38;5;236m, sta\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22mtus), .N],\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m95\u001b[11G\u001b[22m     \u001b[17G      res[status \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"CHECK\"\u001b[38;5;236m, .N], res[status \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"FAIL\"\u001b[38;5;236m, .N]))\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m29\u001b[6G篇全部找得到，沒有任何一篇失敗；26\u001b[41G篇兩個資料庫完全吻合，另外\u001b[68G3\u001b[70G篇需要人工確認。我看一下這\u001b[97G3\u001b[99G篇是哪裡不一致。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[39m 三篇文獻都查核確認為真，差異出自資料庫登記方式（副標題分離、線上搶先版\u001b[74Gvs\u001b[77G正式版），並發現\u001b[94GOpenEvidence\r\u001b[2C\u001b[1B誤給了一個心臟科論文的\u001b[26"]
[1469.843054, "o", "GPMID（但我們程式用\u001b[45GDOI\u001b[49G查得正確號碼未受影響）。我已強化查證程式：合併標題副標題、以\u001b[110GPubMed\r\u001b[2C\u001b[1B為作者依據、卷期頁碼僅在雙方皆有資料時比對。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[2B\u001b[38;5;174m✢\u001b[3GCoalescing… \u001b[30G\u001b[38;5;241m9\u001b[42G\u001b[38;5;249mthinking with high effort\u001b[38;5;241m)\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
