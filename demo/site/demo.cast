[487.014294, "o", "工具可以用。\r\u001b[2B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ Rscript -e 'for (p in c(\"consort\",\"DiagrammeR\",\"ggplot2\",\"ragg\",\"svglite\",\"grid\",\"systemfonts\",\"testthat\")) \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mcat(p, requireNamespace(p, quietly=TRUE), \"\\n\")'; ls ~/her2-study-linkage 2>&1 | head -2\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39m\u001b[1mSkill\u001b[22m(dataviz)\u001b[K\r\u001b[4C\u001b[2B\u001b[38;5;174mcip\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
