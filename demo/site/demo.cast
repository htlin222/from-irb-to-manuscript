[271.079403, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 101 \u001b[22m     known = original \u001b[38;5;125min\u001b[38;5;236m ORIGINAL_TYPES\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 102 \u001b[22m     types = \u001b[38;5;24m\"　\"\u001b[38;5;236m.join(\u001b[38;5;24mf\"\u001b[38;5;236m{check(original == k)}\u001b[38;5;24m \u001b[38;5;236m{v}\u001b[38;5;24m\"\u001b[38;5;236m \u001b[38;5;125mfor\u001b[38;5;236m k, v \u001b[38;5;125min\u001b[38;5;236m ORIGINAL_TYPES.items())\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;160m\u001b[48;5;224m 103 -\u001b[38;5;236m    other = ORIGINAL_TYPES.get(original) or original if not known else \"\"                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 103 +\u001b[38;5;236m    other = original \u001b[38;5;125m\u001b[48;5;157mif\u001b[38;5;236m\u001b[48;5;194m original \u001b[38;5;125m\u001b[48;5;157mand\u001b[38;5;236m\u001b[48;5;194m \u001b[38;5;125mnot\u001b[38;5;236m known \u001b[38;5;125melse\u001b[38;5;236m \u001b[38;5;24m\"\"\u001b[38;5;236m                                              \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m4\u001b[16G\u001b[22madd_p(doc, \u001b[38;5;24mf\"原審查類別：  \u001b[38;5;236m{types}\u001b[38;5;24m　\u001b[38;5;236m{check(\u001b[38;5;31mbool\u001b[38;5;236m(original) \u001b[38;5;125mand\u001b[38;5;236m \u001b[38;5;125mnot\u001b[38;5;236m "]
[271.079565, "o", "known)}\u001b[38;5;24m 其他\"\r\u001b[8C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[16G\u001b[22m     \u001b[22G \u001b[24G   \u001b[38;5;24mf\"\u001b[38;5;236m{\u001b[31Gther \u001b[38;5;125mor\u001b[38;5;236m \u001b[38;5;24m'＿＿＿＿'\u001b[38;5;236m}\u001b[38;5;24m\"\u001b[38;5;236m,\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 106 \u001b[22m           size=\u001b[38;5;31m12\u001b[38;5;236m, sa=Pt(\u001b[38;5;31m4\u001b[38;5;236m), sb=Pt(\u001b[38;5;31m2\u001b[38;5;236m))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m回覆解析正確，第 5 條的「7 年」也自動從設定檔帶入了。接著產生複審文件（SF019 回覆表加上修正後的計畫摘要）。\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[2B計畫摘要加了內容仍是 2 頁。SF019 因為回覆比較長，從空白表單的 2 頁變成 3 頁，我看一下排版有沒有問題。\u001b[K\r\u001b[3C\u001b[2B\u001b[38;5;241mead \u001b[1m3\u001b[22m fi\u001b[13Ges, ran \u001b[1m1\u001b[23G\u001b[22mshell command \r\u001b[2C\u001b[2B\u001b[39m表格三欄寬度平均分配，「項次」欄因 LibreOffice\u001b[K\r\u001b[2C\u001b[1B不支援只在儲存格設定寬度而浪費空間，且第三節「修正內容」漏"]
