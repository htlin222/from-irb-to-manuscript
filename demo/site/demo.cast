[1842.099802, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39m53:\u001b[29Gsurvival\u001b[38G=\u001b[40GTRUE,\u001b[46Gps\u001b[49G=\u001b[51GNULL)\u001b[57G{\r\u001b[2B\u001b[38;5;241m  ⎿  \u001b[39mUpda\u001b[11Ged \u001b[1manalysis/R/estimation.R\u001b[22m \u001b[38;5;241m(+3 -2)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 48 \u001b[22m }\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 49 \u001b[22m \u001b[29G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 50 \u001b[22m \u001b[38;5;246m# ── 一份資料、一種平衡方法的完整分析 ─────────────────────────────────────\r\u001b[1B\u001b[39m     \u001b[38;5;29m\u001b[48;5;194m 51 +\u001b[38;5;246m# ps：可另給傾向分數公式（事後分析用，例如年份改用樣條）；預設為 SAP 的模型\u001b[38;5;236m                          \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m52\u001b[11G\u001b[22manalyze \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(x, method \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"overlap\"\u001b[38;5;236m, \u001b[38;5;24m\"match\"\u001b[38;5;236m, \u001b[38;5;24m\"regression\"\u001b[38;5;236m), outcome \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"pcr\"\u001b[38;5;236m, drop \u001b[38;5;125m=\u001b["]
[1842.100296, "o", "38;5;236m characte\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22mr(),\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 52 -\u001b[38;5;236m                    survival = TRUE) {                                                               \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m3\u001b[11G\u001b[38;5;236m                    survival \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mTRUE\u001b[38;5;236m\u001b[48;5;157m, ps \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mNULL\u001b[38;5;236m\u001b[48;5;194m) {                                                    \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m  method \u001b[38;5;125m<-\u001b[38;5;236m match.arg(method)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 54 -\u001b[38;5;236m  f <- ps_formula(drop)                                                                              \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 55 +\u001b[38;5;236m  f \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125m\u001b[48;5;157mif\u001b[38;5;236m (\u001b[38;5;31mis.null\u001b[38;5;236m(ps)) \u001b[48;5;194mps_formula(drop)\u001b[48;5;157m \u001b[38;5;125melse\u001b[38;5;236m ps\u001b[48;5;194m                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 56 \u001b[22m   out \u001b[38;5;125m<-\u001b[38;5;236m "]
[1842.100581, "o", "\u001b[38;5;31mlist\u001b[38;5;236m(n \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;31msum\u001b[38;5;236m(x\u001b[38;5;125m$\u001b[38;5;236mdual \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;31m0\u001b[38;5;236m), \u001b[38;5;31msum\u001b[38;5;236m(x\u001b[38;5;125m$\u001b[38;5;236mdual \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;31m1\u001b[38;5;236m)))\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[13G\u001b[22mevents\u001b[23G\u001b[38;5;125mfunction\u001b[38;5;236m(dt) dt[, .(efs \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31msum\u001b[38;5;236m(efs_event), os \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31msum\u001b[38;5;236m(os_event)), keyby \u001b[38;5;125m=\u001b[38;5;236m dual]\r\u001b[5C\u001b[1B\u001b[2m 58 \u001b[22m   \u001b[38;5;125mif\u001b[38;5;236m (method \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"overlap\"\u001b[38;5;236m) {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1hwojb5;file:///Users/Shared/her2-neoadjuvant-study/analysis/R/posthoc_revision1.R\u0007analysis/R/posthoc_revision1.R\u001b]8;;\u0007)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
