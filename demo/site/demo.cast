[1760.121397, "o", "[38;5;236m, \u001b[38;5;24m\"生成式 AI 使用揭露已撰寫\"\u001b[38;5;236m, \u001b[38;5;125m!\u001b[38;5;236mgrepl(\u001b[38;5;24m\"Use of Generative AI\\\\s*\\\\n+\\\\s*\\\\[TO BE WRITTEN\"\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m  \u001b[10G \u001b[22m , texts\u001b[38;5;125m$\u001b[38;5;236mstatements))\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m 95 \u001b[22m   add(\u001b[38;5;24m\"error\"\u001b[38;5;236m,\u001b[27G\u001b[38;5;24m\"兩個檔案都有「synthetic data for teaching」標示\"\u001b[38;5;236m, \u001b[38;5;31mall\u001b[38;5;236m(files\u001b[38;5;125m$\u001b[38;5;236msy\u001b[91Gthetic_label))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  96 +\u001b[38;5;236m  add(\u001b[38;5;24m\"warning\"\u001b[38;5;236m, \u001b[38;5;24m\"本稿為 AI 撰寫之教學示範稿（不得投稿；真實投稿時內文須由作者親自撰寫）\"\u001b[38;5;236m, \u001b[38;5;125m!\u001b[38;5;31many\u001b[38;5;236m(file\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[10G +\u001b[38;5;236ms\u001b[38;5;125m$\u001b[38;5;236mai_demo_label),                                                                                   \r\u001b[7C\u001b[1B\u001b[38;5;29m97 +\u001b[38;5;236m  \u001b[15G   \u001b[38;5;125mif\u001b[38;5;236m (\u001b[38;5;31many\u001b[38;5;236m(files\u001b[38;5;125m$\u001b[38;5;236m"]
