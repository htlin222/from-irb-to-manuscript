[581.016474, "o", "\u001b[?25l\u001b[H\u001b[6Glibrary(testthat)\r\u001b[1B \u001b[3G   source(test_path(\"..\", \u001b[30GR\", \"definitions.R\"))\u001b[K\r\u001b[5C\u001b[1B\u001b[2m… +7 lines\u001b[22m\u001b[K\r\u001b[5C\u001b[1BUpdated \u001b[1manalysis/tests/test_definitions.R\u001b[22m \u001b[38;5;241m(+2 -2)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 1 \u001b[22m \u001b[38;5;246m# 治療分組與收案相關定義的測試。執行：make test-analysis\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 2 \u001b[22m library(testthat)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 3 -\u001b[38;5;236msource(\"analysis/R/definitions.R\")                                                                    \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;29m\u001b[48;5;194m 3 +\u001b[38;5;236msource(\u001b[48;5;157mtest_path(\u001b[38;5;24m\u001b[48;5;194m\"\u001b[48;5;157m..\"\u001b[38;5;236m, \u001b[38;5;24m\"\u001b[48;5;194mR\u001b[48;5;157m\"\u001b[38;5;236m, \u001b[38;5;24m\"\u001b[48;5;194mdefinitions.R\"\u001b[38;5;236m)\u001b[48;5;157m)\u001b[48;5;194m                                                         \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236mdm <- fread(\"analysis/drug_map.csv\", colClasses = \"character\", na.strings = \"\")               "]
[581.018416, "o", "        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236mdm \u001b[38;5;125m<-\u001b[38;5;236m fread(\u001b[48;5;157mtest_path(\u001b[38;5;24m\u001b[48;5;194m\"\u001b[48;5;157m..\"\u001b[38;5;236m, \u001b[38;5;24m\"\u001b[48;5;194mdrug_map.csv\"\u001b[38;5;236m\u001b[48;5;157m)\u001b[48;5;194m, colClasses \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"character\"\u001b[38;5;236m, na.strings \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"\"\u001b[38;5;236m)               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m d \u001b[38;5;125m<-\u001b[38;5;236m as.IDate\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\r\u001b[5C\u001b[1B 8 \u001b[22m orders \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(...) {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m20\u001b[6G項測試全部通過。接著寫收案流程，並畫流程圖。\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1ag9qmn;file:///Users/Shared/her2-neoadjuvant-study/analysis/R/cohort.R\u0007analysis/R/cohort.R\u001b]8;;\u0007)\u001b[K\r\u001b[2B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[20C\u001b[2B\u001b[38;5;241m5\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
