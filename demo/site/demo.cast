[940.225471, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m原來是因為\u001b[14G\u001b[38;5;105mdata/raw/\u001b[24G\u001b[39m資料夾已存在且含有指紋清單，我建的連結被放錯位置導致找不到原始檔，而非資料本身有問題，驗證機制\r\u001b[2C\u001b[1B也確實正確攔下了這個錯誤。我會改為逐一連結每個原始檔，並用版本紀錄中的指紋清單來核對。\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m乾淨重跑成功。現在把每個結果檔和存檔版本逐一比對。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m9個機器可讀結果檔和PNG圖完全一致，差異僅在報告中的產生時間與版本編號，PDF/Word內容抽出比對後也確認相同。接下來我要做\r\u001b[2C\u001b[1B更嚴格的測試：模擬在另一台電腦重跑、研究編號全部重新隨機產生。\r\u001b[2B\u001b[38;5;241"]
[940.225595, "o", "m \u001b[3G\u001b[39mVerifying PDF/Word content and rerunning with fresh study IDs\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ R1=\"$TMPDIR/rerun1\"; cd \"$R1\" && for f in results/figures/*.pdf; do diff -q <(pdftotext \"$f\" - 2>/dev/null) \r\u001b[5C\u001b[1B<(git show \"HEAD:$f\" | pdftotext - - 2>/dev/null) >/dev/null && echo \" PDF 內容相同 $f\" || echo \" PDF 內容不同 \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m$f\"; done; diff -q <(unzip -p results/table1.docx word/document.xml) <(git show HEAD:r…\r\u001b[2C\u001b[2B\u001b[38;5;180mSock-hopping…\u001b[21G\u001b[38;5;241m1\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
