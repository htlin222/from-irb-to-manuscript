[1395.844466, "o", "\u001b[?25l\u001b[H     \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22mfmt_pct \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(x, d \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m1\u001b[41G\u001b[38;5;236msprintf(paste0(\u001b[38;5;24m\"%.\"\u001b[38;5;236m, d, \u001b[38;5;24m\"f%%\"\u001b[38;5;236m), \u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m x)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236mfmt_ci <- function(est, lo, hi, d = 2) sprintf(paste0(\"%.\", d, \"f (95%% CI, %.\", d, \"f–%.\", d, \"f)\"),\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m est, lo, hi)                                                                                        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  7 +\u001b[38;5;246m# 區間：下限為負時用 \"to\" 與真正的負號，避免「-1.7–39.3」被誤讀\u001b[38;5;236m                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m  8 +\u001b[38;5;236mci_range \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(lo, hi, d \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m) {                                                               "]
[1395.845759, "o", " \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m  f \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(x) sub(\u001b[38;5;24m\"^-\"\u001b[38;5;236m, \u001b[38;5;24m\"−\"\u001b[38;5;236m, sprintf(paste0(\u001b[38;5;24m\"%.\"\u001b[38;5;236m, d, \u001b[38;5;24m\"f\"\u001b[38;5;236m),\u001b[75Gx))\r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m  paste0(f(lo), ifelse(lo \u001b[38;5;125m<\u001b[38;5;236m \u001b[38;5;31m0\u001b[38;5;236m,\u001b[42G\u001b[38;5;24m\" to \"\u001b[38;5;236m,\u001b[50G\u001b[38;5;24m\"–\"\u001b[38;5;236m),\u001b[56Gf(hi))\r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m}\u001b[13G \u001b[15G                                                                                                 \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[11G\u001b[38;5;236mfmt_ci \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(est, lo,\u001b[39Ghi, d \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m)\u001b[50Gsprint\u001b[58G\u001b[38;5;24m\"%s (95%% CI, %s)\"\u001b[38;5;236m,\u001b[78Gsprintf(paste0(\u001b[38;5;24m\"%.\"\u001b[38;5;236m,\u001b[99Gd,\u001b[102G\u001b[38;5;24m\"f\"\u001b[38;5;236m),\u001b[108Gest)\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m,\u001b[13Gci_range(lo,\u001b[26Ghi,\u001b[30Gd))\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 13 \u001b[22m fmt_p \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;"]
[1395.845934, "o", "125mfunction\u001b[38;5;236m(p) \u001b[38;5;125mif\u001b[38;5;236m (p \u001b[38;5;125m>=\u001b[38;5;236m \u001b[38;5;31m0.001\u001b[38;5;236m) sprintf(\u001b[38;5;24m\"*P* = %.3f\"\u001b[38;5;236m, p) \u001b[38;5;125melse\u001b[38;5;236m sprintf(\u001b[38;5;24m\"*P* = %s\"\u001b[38;5;236m, formatC(p, for\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m mat \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"g\"\u001b[38;5;236m, digits \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m))\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[15G\u001b[22mn_of\u001b[20G\u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(k,\u001b[35Gn)\u001b[38Gsprintf(\u001b[38;5;24m\"%d/%d (%.1f%%)\"\u001b[38;5;236m, k, n\u001b[70G\u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m k\u001b[78G\u001b[38;5;125m/\u001b[38;5;236m n)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m15\u001b[11G\u001b[22mfm\u001b[14G_month \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(d) format(as.Date(d), \u001b[38;5;24m\"%B %Y\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRechecking CI formatting in tables and tokens\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ Rscript -e 'source(\"manuscript/R/tables.R\"); print(table_pcr()$data[[5]]); tk <- manuscript_tokens(); \r\u001b[1B\u001b[39m \u001b[3"]
[1395.846062, "o", "G   \u001b[38;5;241mprint(tk[c(\"pcr_or_s1\",\"pcr_rd\",\"pcr_or\")])'\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=7iwlnu;file:///Users/Shared/her2-neoadjuvant-study/manuscript/R/tokens.R\u0007manuscript/R/tokens.R\u001b]8;;\u0007)\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1395.849257, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236m, ci_range(lo, hi, d))                                                                               \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m13\u001b[16G\u001b[22m \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(p) \u001b[38;5;125mif\u001b[38;5;236m (p\u001b[38G\u001b[38;5;125m>=\u001b[41G\u001b[38;5;31m0.001\u001b[38;5;236m) s\u001b[50Grintf\u001b[57G\u001b[38;5;24m*P* = %.3\u001b[67G\"\u001b[38;5;236m, p)\u001b[73G\u001b[38;5;125melse\u001b[38;5;236m sprintf(\u001b[38;5;24m\"*P* = %s\"\u001b[38;5;236m, formatC(p, for\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m mat \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"g\"\u001b[38;5;236m, digits \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 14 \u001b[22m fmt_n_of \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(k, n) sprintf(\u001b[38;5;24m\"%d/%d (%.1f%%)\"\u001b[38;5;236m, k, n, \u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m k \u001b[38;5;125m/\u001b[38;5;236m n)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 15 \u001b[22m fmt_month \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(d) format(as.Date(d), \u001b[38;5;24m\"%B %Y\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1"]
[1395.849385, "o", "B\u001b[38;5;241mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=7iwlnu;file:///Users/Shared/her2-neoadjuvant-study/manuscript/R/tokens.R\u0007manuscript/R/tokens.R\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 49 \u001b[22m     pcr_crude_dual \u001b[38;5;125m=\u001b[38;5;236m fmt_n_of(d1(\u001b[38;5;24m\"pcr_n\"\u001b[38;5;236m, \u001b[38;5;24m\"dual\"\u001b[38;5;236m), d1(\u001b[38;5;24m\"n\"\u001b[38;5;236m, \u001b[38;5;24m\"dual\"\u001b[38;5;236m)),\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m50\u001b[11G\u001b[22m    \u001b[16Gcr_crude_single\u001b[32G\u001b[38;5;125m=\u001b[38;5;236m fmt_n_of(d1(\u001b[38;5;24m\"pcr_n\"\u001b[38;5;236m, \u001b[38;5;24m\"single\"\u001b[38;5;236m), d1(\u001b[38;5;24m\"n\"\u001b[38;5;236m, \u001b[38;5;24m\"single\"\u001b[38;5;236m)),\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m51\u001b[11G\u001b[22m   \u001b[15Gpcr_w_dual \u001b[38;5;125m=\u001b[38;5;236m fmt_pct(P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mpcr_dual), pcr_w_single \u001b[38;5;125m=\u001b[38;5;236m fmt_pct(P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;23"]
[1395.851116, "o", "6mpcr_single),\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 52 -\u001b[38;5;236m    pcr_rd = sprintf(\"%.1f percentage points (95%% CI, %.1f–%.1f)\", 100 * P(\"main\")$rd, 100 * P(\"main\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m\")$rd_lo,                                                                                            \r\u001b[5C\u001b[1B\u001b[38;5;160m 53 -\u001b[38;5;236m                     100 * P(\"main\")$rd_hi),                                                         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 52 +\u001b[38;5;236m    pcr_rd \u001b[38;5;125m=\u001b[38;5;236m sprintf(\u001b[38;5;24m\"%.1f percentage points (95%% CI, %\u001b[48;5;157ms\u001b[48;5;194m)\"\u001b[38;5;236m, \u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mrd,                     \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;29m\u001b[48;5;194m 53 +\u001b[38;5;236m                     \u001b[48;5;157mci_range(\u001b[38;5;31m\u001b[48;5;194m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236m\u001b[48;5;157mrd_lo, \u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;2"]
[1395.851249, "o", "36m P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236m\u001b[48;5;194mrd_hi\u001b[48;5;157m, \u001b[38;5;31m1\u001b[38;5;236m\u001b[48;5;194m)\u001b[48;5;157m)\u001b[48;5;194m,                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 54 \u001b[22m     pcr_or \u001b[38;5;125m=\u001b[38;5;236m fmt_ci(P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mor, P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mor_lo, P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mor_hi), pcr_p \u001b[38;5;125m=\u001b[38;5;236m fmt_p(P(\u001b[38;5;24m\"main\"\u001b[38;5;236m)\u001b[38;5;125m$\u001b[38;5;236mp),\r\u001b[5C\u001b[1B\u001b[2m 55 \u001b[22m     evalue_pcr \u001b[38;5;125m=\u001b[38;5;236m sprintf(\u001b[38;5;24m\"%.2f\"\u001b[38;5;236m, ev[endpoint \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"pCR (OR)\"\u001b[38;5;236m, point]),\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 56 \u001b[22m     evalue_pcr_ci \u001b[38;5;125m=\u001b[38;5;236m sprintf(\u001b[38;5;24m\"%.2f\"\u001b[38;5;236m, ev[endpoint \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"pCR (OR)\"\u001b[38;5;236m, lower]),\r\u001b[2C\u001b[2B\u001b[38;5;180mGarnishing…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
