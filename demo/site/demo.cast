[1580.927168, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=7iwlnu;file:///Users/Shared/her2-neoadjuvant-study/manuscript/R/tokens.R\u0007manuscript/R/tokens.R\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m6\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  4 \u001b[22m source(\u001b[38;5;24m\"analysis/R/common.R\"\u001b[38;5;236m)   \u001b[38;5;246m# study_facts()\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22mfmt_pct \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(x, d \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m1\u001b[38;5;236m) sprintf(paste0(\u001b[38;5;24m\"%.\"\u001b[38;5;236m, d, \u001b[38;5;24m\"f%%\"\u001b[38;5;236m), \u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38;5;236m x)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236mfmt_ci <- function(est, lo, hi, d = 2) sprintf(paste0(\"%.\", d, \"f (95%% CI, %.\", d, \"f–%.\", d, \"f)\"),\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m est, lo, hi)                                                                                        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  7 "]
[1580.927309, "o", "+\u001b[38;5;246m# 區間：下限為負時用 \"to\" 與真正的負號，避免「-1.7–39.3」被誤讀\u001b[38;5;236m                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m  8 +\u001b[38;5;236mci_range \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(lo, hi, d \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m) {                                                                \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m  f \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(x) sub(\u001b[38;5;24m\"^-\"\u001b[38;5;236m, \u001b[38;5;24m\"−\"\u001b[38;5;236m, sprintf\u001b[53Gpaste0(\u001b[38;5;24m\"%.\"\u001b[38;5;236m, d\u001b[69G\u001b[38;5;24m\"f\"\u001b[38;5;236m), x))         \u001b[88G                    \u001b[109G  \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m  paste0(f(lo), ifelse(lo \u001b[38;5;125m<\u001b[38;5;236m \u001b[38;5;31m0\u001b[38;5;236m, \u001b[38;5;24m\" to \"\u001b[38;5;236m, \u001b[38;5;24m\"–\"\u001b[38;5;236m), f(hi))                                                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m}                                                                                                    \r\u001b[5C\u001b[1B"]
[1580.927468, "o", "\u001b[38;5;29m 12 +\u001b[38;5;236mfmt_ci \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(est, lo, hi, d \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m) sprintf(\u001b[38;5;24m\"%s (95%% CI, %s)\"\u001b[38;5;236m, sprintf(paste0(\u001b[38;5;24m\"%.\"\u001b[38;5;236m, d, \u001b[38;5;24m\"f\"\u001b[38;5;236m), est)\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m, ci_range(lo, hi, d))                                                                               \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m13\u001b[11G\u001b[22mfmt_p \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(p) \u001b[38;5;125mif\u001b[38;5;236m (p \u001b[38;5;125m>=\u001b[38;5;236m \u001b[38;5;31m0.001\u001b[38;5;236m) sprintf(\u001b[38;5;24m\"*P* = %.3f\"\u001b[38;5;236m, p) \u001b[38;5;125melse\u001b[38;5;236m sprintf(\u001b[38;5;24m\"*P* = %s\"\u001b[38;5;236m, formatC(p, for\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22mmat \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"g\"\u001b[38;5;236m, digits \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m))\r\u001b[5C\u001b[1B\u001b[2m 14 \u001b[22m fmt_n_of \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(k, n) sprintf(\u001b[38;5;24m\"%d/%d (%.1f%%)\"\u001b[38;5;236m, k, n, \u001b[38;5;31m100\u001b[38;5;236m \u001b"]
[1580.927628, "o", "[38;5;125m*\u001b[38;5;236m k \u001b[38;5;125m/\u001b[38;5;236m n)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 15 \u001b[22m fmt_month \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(d) format(as.Date(d), \u001b[38;5;24m\"%B %Y\"\u001b[38;5;236m)\r\u001b[4B\u001b[38;5;174m✢\u001b[20G\u001b[38;5;241m9\u001b[30G2\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
