[1552.67187, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote \u001b[1m84\u001b[22m lines to\u001b[24G\u001b[1mmanuscript/style/make_reference_docx.py\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;5;236m\u001b[2m 1 \u001b[22m\u001b[38;5;24m\"\"\"Build the Word style template for JCRP submissions (manuscript/style/reference.docx).\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 2 \u001b[22m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 3 \u001b[22mStarts \u001b[38;5;125mfrom\u001b[38;5;236m pandoc\u001b[38;5;24m's default reference.docx and applies manuscript/journal.yaml'\u001b[38;5;236ms \u001b[38;5;31mformat\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[9G\u001b[22mrules that a style can carry: double spacing, \u001b[38;5;31m2.5\u001b[38;5;236m cm margins, page numbers at the bottom,\r\u001b[6C\u001b[1B\u001b[2m5\u001b[9G\u001b[22mTimes New Roman \u001b[38;5;31m12\u001b[38;5;236m pt, headings \u001b[38;5;125min\u001b[38;5;236m title \u001b[38;5;125mcase\u001b[38;5;236m \u001b[38;5;125mas\u001b[38;5;236m typed (no ALL CAPS, no theme colours).\r\u001b[6C\u001b[1B\u001b[2m6\u001b[9G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[9G\u001b[22mUsage: uv run p\u001b[25Gthon manuscript/style/m\u001b[49Gke_referen\u001b[60Ge_docx.py <\u001b[73Gndoc-default.docx> <out.docx>\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22m\u001b[38;5;24m\"\"\"\u001b[39"]
