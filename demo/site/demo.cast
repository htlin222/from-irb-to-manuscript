[916.529763, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m45\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1manalysis/R/analysis_data.R\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;5;236m\u001b[2m 1 \u001b[22m\u001b[38;5;246m# 分析資料集：收案名單中每位病人一列，含治療組、治療前特徵（SAP §4）、pCR、EFS、OS、術後 T-DM1。\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m 2 \u001b[22m\u001b[38;5;246m# 所有定義都來自 definitions.R。輸出 data/derived/analysis.csv（去識別化，不進 git）。\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m3\u001b[9G\u001b[22msource(\u001b[38;5;24m\"analysis/R/common.R\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[9G\u001b[22msource(\u001b[38;5;24m\"analysis/R/definitions.R\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[9G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[9G\u001b[22mDERIVED_DIR \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;24m\"data/der\u001b[34Gved\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[9G\u001b[22mp \u001b[38;5;125m<-\u001b[38;5;236m params()\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22mfacts \u001b[38;5;125m<-\u001b[38;5;236m study_facts()\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[9G\u001b[22mrd \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;23"]
[916.529914, "o", "6m(k) fread(file.path(DERIVED_DIR, paste0(k, \u001b[38;5;24m\".csv\"\u001b[38;5;236m)), colClasses \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"character\"\u001b[38;5;236m, na.strings\r\u001b[6C\u001b[1B\u001b[2m \u001b[9G\u001b[22m \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mNULL\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m… +36 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m she\u001b[13Gl command \r\u001b[2B\u001b[38;5;16m⏺\u001b[3G\u001b[39m分析資料集已建好，共615人，pCR無缺值，缺值僅出現在年齡（1人）、分級（47人）、Ki-67（71人），符合預期。接著撰寫主分析\r\u001b[1B  程式，先確認繪製存活曲線所需的繪圖套件是否已安裝。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[2B\u001b[38;5;174m✳\u001b[3GUn\u001b[38;5;216mfur\u001b[38;5;174mling… \u001b[27G\u001b[38;5;241m3\u001b[29G8\u001b[41G\u001b[38;5;249mthinking with high effort\u001b[38;5;241m)\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
