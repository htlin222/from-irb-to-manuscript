[643.324585, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m  1 \u001b[22m\u001b[38;5;246m# 資料查詢與處理紀錄（每項對應資料檢查報告的編號）。\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m\u001b[38;5;246m# 查詢：2026/11 向資訊室提出；回覆：correspondence/資訊室_查詢回覆.md；更正：data/raw/資訊室_資料更正.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m    \u001b[22m\u001b[38;5;246mcsv\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  3 \u001b[22m\u001b[38;5;246m# status：\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  4 \u001b[22m\u001b[38;5;246m#   corrected  已由更正檔修正（套用後該項檢查應為 0）\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  6 \u001b[22m\u001b[38;5;246m#   confirmed  查證後確認資料正確，依收案條件處理\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[12G\u001b[22m\u001b[38;5;246m  decided    醫師決定的處理方式（記錄於 analysis/decision_log.md）\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[10G\u001b[22m- \u001b[38;5;31mid:\u001b[38;5;236m \u001b[38;5;24mB3\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[10G\u001b[22m  \u001b[38;5;31mstatus:\u001b[38;5;236m \u001b[38;5;24maccepted\r\u001b[5C\u001b[1B\u001b[38;5;241m… +32 lines \u001b"]
[643.324727, "o", "[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mReporting resolved queries and counting only unresolved errors\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 - <<'EOF'\r\u001b[5C\u001b[1Bimport pathlib\r\u001b[5C\u001b[1Bp = pathlib.Path(\"analysis/R/validate_raw.R\"); s = p.read_text()\r\u001b[5C\u001b[1Bpairs\u001b[12G= [\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m('raw <- lapply(setNames(names(p$raw_files), names(p$raw_files)), read_raw, p = p)\\n',\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m'rr <- read_all_raw(p) # 已套用資訊室更正\\nraw <- rr$raw\\n'),\r\u001b[1B\u001b[39m     \u001b[38;5;241m('''res[, level := factor(level, c(\"error\", \"war…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
