[1978.364372, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 51 \u001b[22m     hit \u001b[38;5;125m<-\u001b[38;5;236m Find(\u001b[38;5;125mfunction\u001b[38;5;236m(i) sub(\u001b[38;5;24m\"^Results/\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m, h) \u001b[38;5;125m%in%\u001b[38;5;236m pg_lines[[i]], seq(at, counts\u001b[38;5;125m$\u001b[38;5;236mpages))\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mUpdated \u001b[1mmanuscript/R/render_util.R\u001b[22m \u001b[38;5;241m(+13 -0)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 30 \u001b[22m     vapply(people, \u001b[38;5;125mfunction\u001b[38;5;236m(p) p\u001b[38;5;125m$\u001b[38;5;236memail \u001b[38;5;125m%||%\u001b[38;5;236m \u001b[38;5;24m\"\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m), cfg\u001b[38;5;125m$\u001b[38;5;236mstudy\u001b[38;5;125m$\u001b[38;5;236mirb_no,\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 31 \u001b[22m     unlist(inst[\u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"name\"\u001b[38;5;236m, \u001b[38;5;24m\"name_en\"\u001b[38;5;236m, \u001b[38;5;24m\"short_name\"\u001b[38;5;236m, \u001b[38;5;24m\"heading\"\u001b[38;5;236m)]), \u001b[38;5;24m\"KFSYSCC\"\u001b[38;5;236m, \u001b[38;5;24m\"Koo Foundation\"\u001b[38;5;236m)))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 32 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 33 +\u001b[38;5;236m                 "]
