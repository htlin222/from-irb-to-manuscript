[406.020389, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✶\u001b[9G\u001b[38;5;216mi\u001b[12G\u001b[38;5;174m…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[406.122096, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✻\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[406.224889, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✽\u001b[8G\u001b[38;5;216mh\u001b[11G\u001b[38;5;174mg\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[406.456964, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[21B\u001b[38;5;216mc\u001b[10G\u001b[38;5;174mn\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[406.47283, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[19B我會檢查資料本身可不可靠，例如欄位、合理範圍、重複、日期先後、各檔能不能對得上。但不會去比較兩組的\u001b[102GpCR\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[406.676261, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✻\u001b[6G\u001b[38;5;216mn\u001b[9G\u001b[38;5;174mi\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
