[664.436736, "o", "\u001b[?25l\u001b[H\u001b[3G│\u001b[6G          項目            │                                       處理                                    \u001b[115G│\r\u001b[2C\u001b[1B├────────────────────────────┼──────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G2 筆手術日期年份打錯、2    │ 用資訊室的更正檔修正。原始檔一個字都沒改，讀資料時才套用更正，而且會先核對舊值和\u001b[115G│\r\u001b[2C\u001b[1B│\u001b[5G筆復發類別登錯             │ 原始資料相符          \u001b[115G│\r\u001b[2C\u001b[1B├────────────────────────────┼─────────────────────────────────────────────────────"]
[664.43799, "o", "─────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G生物相似藥的品名被換成現行 │\u001b[34G成分都是\u001b[43Gtrastuzumab，分組只看成分，不受影響。\u001b[1mpertuzumab 從 2012 \u001b[115G\u001b[22m│\r\u001b[1B  │ 品名    \u001b[14G                  │ \u001b[1m年起的紀錄是完整的\u001b[22m，分組可以放心\u001b[115G│\r\u001b[2C\u001b[1B├────────────────────────────┼──────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│\u001b[5G死亡後的醫囑               │ 是預開、沒有執行的醫囑，分析時排除 \u001b[115G│\r\u001b[2C\u001b[1B├────────────────────────────┼──────────────────────────────"]
