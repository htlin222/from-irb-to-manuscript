[911.992169, "o", "   \u001b[56G \u001b[58G  \r\u001b[8C\u001b[1B\u001b[38;5;29m7\u001b[21G\u001b[38;5;236msetequal(PS_COVARIATES, \u001b[38;5;31mnames\u001b[38;5;236m(cv))\u001b[56G      \r\u001b[8C\u001b[1B\u001b[38;5;29m8\u001b[12G\u001b[38;5;236m})                                                                                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m41項測試全數通過。接下來我會建立分析資料集（analysis_data.R）並撰寫主分析與敏感度分析程式（outcomes.R），同時將Table\r\u001b[2C\u001b[1B1改用統一的特徵編碼，確保與傾向分數模型定義一致。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=17fmkyj;file:///Users/Shared/her2-neoadjuvant-study/analysis/R/analysis_data.R\u0007analysis/R/analysis_data.R\u001b]8;;\u0007)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[911.993536, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m41項測試全數通過。接下來我會建立分析資料集（analysis_data.R）並撰寫主分析與敏感度分析程式（outcomes.R），同時將Table\r\u001b[2C\u001b[1B1改用統一的特徵編碼，確保與傾向分數模型定義一致。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=17fmkyj;file:///Users/Shared/her2-neoadjuvant-study/analysis/R/analysis_data.R\u0007analysis/R/analysis_data.R\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote \u001b[1m45\u001b[22m lines to \u001b[1manalysis/R/analysis_data.R\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 1 \u001b[22m\u001b[38;5;246m# 分析資料集：收案名單中每位病人一列，含治療組、治療前特徵（SAP §4）、pCR、EFS、OS、術後 T-DM1。\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 2 \u001b[22m\u001b[38;5;246m# 所有定義都來自 definitions.R。輸出 data/derived/analysis.csv（去識別化，不進 git）。\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 3 \u001b[22msource(\u001b[38;5;24m\"analysis/R/common.R\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m"]
