[265.966474, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;29m\u001b[48;5;194m37\u001b[11G\u001b[38;5;236m    Each section\u001b[38;5;24m's first paragraph is the committee'\u001b[38;5;236ms\u001b[65Gcomment\u001b[73G(optionally\r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[15G\u001b[38;5;236mprefixed 審查意見：),\u001b[37Gthe\u001b[41Grest\u001b[46G\u001b[38;5;125mis\u001b[38;5;236m the reply (optionally prefixed 回覆：).                        \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[15G\u001b[38;5;236m`{dotted.config.key}` placeholders \u001b[38;5;125min\u001b[38;5;236m the reply are filled\u001b[74G\u001b[38;5;125mfrom\u001b[79G\u001b[38;5;236mconfig.\r\u001b[6C\u001b[1B\u001b[38;5;29m40\u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m                                                                                              \r\u001b[6C\u001b[1B\u001b[38;5;29m41\u001b[15G\u001b[38;5;236mrows\u001b[20G=\u001b[22G[]\r\u001b[6C\u001b[1B\u001b[38;5;29m42\u001b[11G\u001b[38;5;236m    \u001b[38;5;125mfor\u001b[38;5;236m body \u001b[38;5;125min\u001b[38;5;236m responses.values():    \r\u001b[6C\u001b[1B\u001b[38;5;29m43\u001b[15G\u001b[38;5;236m    comment, _, reply = (body \u001b[38;5;125mif\u001b[38;5;236m \u001b[38;5;31misinstance\u001b[38;5;236m(body,\u001b[65G\u001b[38;5;31mstr\u001b[38;5;236m)\u001b[70G\u001b[38;5;125melse\u001b[75G\u001b[38;5;24m\"\\n\"\u001b[38;5;236m.join(bod"]
