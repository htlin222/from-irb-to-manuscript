[1480.172427, "o", "\u001b[?25l\u001b[H \u001b[3G   art-6.p\u001b[14Gg\u001b[16G\u001b[K\r\u001b[5C\u001b[1B\u001b[2m… +3 lines\u001b[22m\u001b[K\r\u001b[5C\u001b[1BUpdated \u001b[1mmanuscript/article.qmd\u001b[22m \u001b[38;5;241m(+1 -1)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 42 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 43 \u001b[22m # 縮放欄寬到頁寬（A4 扣掉 2.5 cm 邊界約 6.3 吋），字體維持 10 pt，必要時換行（fit_to_width 會縮小字體\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m ）\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 44 \u001b[22m fit_page <- function(x, page = 6.3) {\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 45 -\u001b[38;5;236m  w <- flextable::dim_pretty(x)$widths                                                               \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 45 +\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x, part = \"body\")$widths, 0.6)   # 依內容（不依長標題）決定欄寬；標\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m題自動換行                                                                                           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[11G\u001b[22m  w[1] <- max(w[1], 1.8)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 47 \u001b[22m   flextable::wi"]
[1480.172593, "o", "dth(x, width = w * min(1, page / sum(w)))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 48 \u001b[22m }\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[39m Table 3 現在清楚易讀，但\u001b[28GTable\u001b[34G2\u001b[36G欄位較多，數字仍會被擠到斷行。我會把這類多欄表格的字縮小到\u001b[95G9\r\u001b[2C\u001b[1B號並留出緩衝寬度，同時稍微縮窄第一欄讓分析名稱換行顯示。\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[29C\u001b[2B\u001b[38;5;241m6\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
