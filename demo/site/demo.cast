[1580.925267, "o", "                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236mci \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(est, lo, hi, d \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m) ifelse(\u001b[38;5;31mis.na\u001b[38;5;236m(est), \u001b[38;5;24m\"\"\u001b[38;5;236m, sprintf(\u001b[38;5;24m\"%\u001b[48;5;157ms\u001b[48;5;194m (%\u001b[48;5;157ms)\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[48;5;157msprintf(paste0(\u001b[38;5;24m\u001b[48;5;194m\"%.\"\u001b[38;5;236m, d, \r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24m\"f\"\u001b[38;5;236m), est\u001b[48;5;157m)\u001b[48;5;194m, \u001b[48;5;157mci_range(\u001b[48;5;194mlo, hi\u001b[48;5;157m, d\u001b[48;5;194m))\u001b[48;5;157m)\u001b[48;5;194m                                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m pval \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(p) ifelse(\u001b[38;5;31mis.na\u001b[38;5;236m(p), \u001b[38;5;24m\"\"\u001b[38;5;236m, ifelse(p \u001b[38;5;125m>=\u001b[38;5;236m \u001b[38;5;31m0.001\u001b[38;5;236m, sprintf(\u001b[38;5;24m\"%.3f\"\u001b[38;5;236m, p), formatC(p, format \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;24m\"\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mg\"\u001b[38;5;236m"]
