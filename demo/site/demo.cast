[1292.568014, "o", "\u001b[?25l\u001b[H\r\u001b[54C\u001b[13B\u001b[38;5;241m · 2s\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1292.58675, "o", "\u001b[?25l\u001b[H\r\u001b[13B\u001b[38;5;241m⏺\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1292.637665, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m  \u001b[11G\u001b[22mtus), .N],\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m95\u001b[11G\u001b[22m     \u001b[17G      res[status \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"CHECK\"\u001b[38;5;236m, .N], res[status \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"FAIL\"\u001b[38;5;236m, .N]))\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m29\u001b[6G篇全部找得到，沒有任何一篇失敗；26\u001b[41G篇兩個資料庫完全吻合，另外\u001b[68G3\u001b[70G篇需要人工確認。我看一下這\u001b[97G3\u001b[99G篇是哪裡不一致。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m三篇文獻都查核確認為真，差異出自資料庫登記方式（副標題分離、線上搶先版\u001b[74Gvs\u001b[77G正式版），並發現\u001b[94GOpenEvidence\r\u001b[1B \u001b[3G誤給了一個心臟科論文的 PMID（但我們程式用 DOI 查得正確號碼未受影響）。我已強化查證程式：合併標題副標題、以\u001b[110GPubMed\r\u001b[2C\u001b[1B為作者依據、卷期頁碼僅在雙方皆有資料時比對"]
