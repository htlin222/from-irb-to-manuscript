[1409.735741, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m3\u001b[10G\u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[10G\u001b[22m pubmed \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(doi) {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 41 \u001b[22m   s \u001b[38;5;125m<-\u001b[38;5;236m get_json(paste0(\u001b[38;5;24m\"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pubmed&retmode=\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mjson&term=\"\u001b[38;5;236m,\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m 42 \u001b[22m                        utils\u001b[38;5;125m::\u001b[38;5;236mURLencode(paste0(doi, \u001b[38;5;24m\"[doi]\"\u001b[38;5;236m), reserved \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mTRUE\u001b[38;5;236m)))\r\u001b[5C\u001b[1B\u001b[2m 43 \u001b[22m   Sys.sleep(\u001b[38;5;31m0.4\u001b[38;5;236m)   \u001b[38;5;246m# NCBI：無 API key 時每秒最多 3 次\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m 43 -\u001b[38;5;236m  ids <- unlist(s$esearchresult$idlist)                                                              \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 44 +\u001b[38;5;236m  ids \u001b[38;5;125m<-\u001b[38;5;236m unlist(s\u001b[48;5;157m[[\u001b[38;5;24m\"\u001b[48;5;194mesearchresult\u001b[48;5;157m\"\u001b[3"]
[1409.735873, "o", "8;5;236m]]\u001b[38;5;125m\u001b[48;5;194m$\u001b[38;5;236midlist)                                                         \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;236m\u001b[2m 45 \u001b[22m   \u001b[38;5;125mif\u001b[38;5;236m (\u001b[38;5;31mlength\u001b[38;5;236m(ids) \u001b[38;5;125m!=\u001b[38;5;236m \u001b[38;5;31m1\u001b[38;5;236m) \u001b[38;5;31mreturn\u001b[38;5;236m(\u001b[38;5;31mNULL\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[2m 46 \u001b[22m   r \u001b[38;5;125m<-\u001b[38;5;236m get_json(paste0(\u001b[38;5;24m\"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=pubmed&retmode\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24m=json&id=\"\u001b[38;5;236m, ids))\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m 47 \u001b[22m   Sys.sleep(\u001b[38;5;31m0.4\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 47 -\u001b[38;5;236m  x <- r$result[[ids]]                                                                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 48 +\u001b[38;5;236m  x \u001b[38;5;125m<-\u001b[38;5;236m r\u001b[48;5;157m[[\u001b[38;5;24m\"\u001b[48;5;194mresult\u001b[48;5;157m\"\u001b[38;5;236m]]\u001b[48;5;194m[[ids]]                                                        "]
[1409.736033, "o", "                  \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;236m\u001b[2m 49 \u001b[22m   \u001b[38;5;125mif\u001b[38;5;236m (\u001b[38;5;31mis.null\u001b[38;5;236m(x)) \u001b[38;5;31mreturn\u001b[38;5;236m(\u001b[38;5;31mNULL\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 49 -\u001b[38;5;236m  aid <- vapply(x$articleids, function(a) if (a$idtype == \"doi\") a$value else \"\", \"\")                \r\u001b[5C\u001b[1B\u001b[38;5;160m 50 -\u001b[38;5;236m  people <- Filter(function(a) identical(a$authtype, \"Author\"), x$authors)   # 排除團體作者          \r\u001b[5C\u001b[1B\u001b[38;5;160m 51 -\u001b[38;5;236m  authors <- lapply(people, function(a) list(family = sub(\" [A-Z]+$\", \"\", a$name), given = sub(\"^.* \"\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m, \"\", a$name)))                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;241m…\u001b[8G10 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[7Gtimeout 10m)\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
