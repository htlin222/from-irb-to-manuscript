[92.347008, "o", "m\u001b[2m54\u001b[11G\u001b[22m\u001b[38;5;31mencrypted\u001b[38;5;236m            = \u001b[38;5;31mtrue\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m55\u001b[11G\u001b[22m\u001b[38;5;31mretention_years\u001b[38;5;236m      = \u001b[38;5;31m7\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 56 -\u001b[38;5;236mauthorized_personnel = \"王大明（計畫主持人）\"                                                        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 56 +\u001b[38;5;31mauthorized_personnel\u001b[38;5;236m = \u001b[38;5;24m\"\u001b[48;5;157m陳怡君\u001b[48;5;194m（計畫主持人）\u001b[48;5;157m、黃淑芬（協同主持人，生物統計師）\u001b[48;5;194m\"\u001b[38;5;236m                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;241m… 3 more lines \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (files that changed while this command ran, by the command or by another process; a convenience view, not a \r\u001b[5C\u001b[1Breview or audit of the command)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1a3whiy;file:///Users/Shared/her2-neoadjuvant-study/%E4%B8%AD%E6%96%87%E8%A8%88%E7%95%AB%E6%91%98%E8%A6%81.md\u0007中文計畫摘要.md\u001b]8;;\u0007)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241"]
[92.347513, "o", "m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[92.35008, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 56 \u001b[22m ## 統計分析\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 57 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 49 -\u001b[38;5;236m存活分析採Kaplan-Meier法及log-rank檢定，以Cox比例風險模型估計風險比（HR）及95%信賴區間，             \r\u001b[5C\u001b[1B\u001b[38;5;160m 50 -\u001b[38;5;236m並以皮膚毒性為時間相依共變項處理不朽時間偏誤（immortal time bias）。                                 \r\u001b[5C\u001b[1B\u001b[38;5;160m 51 -\u001b[38;5;236m類別變項以卡方或Fisher精確檢定。雙尾p<0.05為統計顯著。                                               \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 58 +\u001b[38;5;236m以邏輯斯迴歸估計傾向分數，共變項含年齡、臨床T與N分期、荷爾蒙受體狀態、組織學分級、化療方案及治療年份 \r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m；                                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 59 +\u001b[38;5;236m以IPTW平衡兩組，標準化平均差（SMD）<0.1"]
[92.350209, "o", "判定平衡。                                                    \r\u001b[5C\u001b[1B\u001b[38;5;29m 60 +\u001b[38;5;236mpCR以加權邏輯斯迴歸估計勝算比（OR）及95%信賴區間，未接受手術者視為未達pCR。                          \r\u001b[5C\u001b[1B\u001b[38;5;29m 61 +\u001b[38;5;236mEFS與OS以Kaplan-Meier法描述，以加權Cox比例風險模型估計風險比（HR）及95%信賴區間（穩健標準誤）。      \r\u001b[5C\u001b[1B\u001b[38;5;29m 62 +\u001b[38;5;236m敏感度分析：（1）限縮於兩種治療並行使用之年份；（2）傾向分數配對；（3）EFS依術後是否接受T-DM1分層；（\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m4）以E-value評估未測量干擾因子之影響。                                                               \r\u001b[6C\u001b[1B\u001b[38;5;29m63\u001b[11G\u001b[38;5;236m缺失值以多重插補處理。樣本數：依NeoSphere試驗pCR約29%對46%估計，總數約650–700人時，即使兩組人數比為1:\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m3，雙尾α=0.05下檢定力仍逾90%。                                   "]
[92.35037, "o", "                                    \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;29m\u001b[48;5;194m 64 +\u001b[38;5;236m雙尾p<0.05為統計顯著，使用R 4.5。本研究無期中分析。                                                  \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 65 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 66 \u001b[22m ## 附件\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 67 \u001b[22m \u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[92.354927, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m·\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[92.396231, "o", "\u001b[?25l\u001b[H\r\u001b[19B\u001b[38;5;241m⏺\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[92.445282, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 49 -\u001b[38;5;236m存活分析採Kaplan-Meier法及log-rank檢定，以Cox比例風險模型估計風險比（HR）及95%信賴區間，             \r\u001b[6C\u001b[1B\u001b[38;5;160m50\u001b[11G\u001b[38;5;236m並以皮膚毒性為時間相依共變項處理不朽時間偏誤（immortal time bias）。                    \r\u001b[7C\u001b[1B\u001b[38;5;160m1\u001b[11G\u001b[38;5;236m類別變項以卡方或Fisher精確檢定。雙尾p<0.05為統計顯著。\u001b[66G    \u001b[71G        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 58 +\u001b[38;5;236m以邏輯斯迴歸估計傾向分數，共變項含年齡、臨床T與N分期、荷爾蒙受體狀態、組織學分級、化療方案及治療年份 \r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m；                                                                                                  \r\u001b[6C\u001b[1B\u001b[38;5;29m59\u001b[11G\u001b[38;5;236m以IPTW平衡兩組，標準化平均差（SMD）<0.1判定平衡。\r\u001b[6C\u001b[1B\u001b[38;5;29m60\u001b[11G\u001b[38;5;236mpCR以加權邏輯斯迴歸估計勝"]
[92.445405, "o", "算比（OR\u001b[46G及95%信賴區間，未接受手術者視為未達pCR。\r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[11G\u001b[38;5;236mEFS與OS以Kaplan-Meier法描述，以加權Cox比例風險模型估計風險比（HR）及95%信賴區間（穩健標準誤）。\r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[11G\u001b[38;5;236m敏感度分析：（1）限縮於兩種治療並行使用之年份；（2）傾向分數配對；（3）EFS依術後是否接受T-DM1分層；（\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m4）以E-value評估未測量干擾因子之影響。                                                               \r\u001b[6C\u001b[1B\u001b[38;5;29m63\u001b[11G\u001b[38;5;236m缺失值以多重插補處理。樣本數：依NeoSphere試驗pCR約29%對46%估計，總數約650–700人時，即使兩組人數比為1:\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m3，雙尾α=0.05下檢定力仍逾90%。                                                                       \r\u001b[6C\u001b[1B\u001b[38;5;29m64\u001b[11G\u001b[38;5;236m雙尾p<0.05為統計顯著，使用R 4.5。本研究無期中分析。\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m"]
