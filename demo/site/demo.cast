[2248.051824, "o", "e submission date\"\u001b[38;5;236m,                                    \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[23G\u001b[22m\u001b[38;5;24m\"□ PI signature on SF037\"\u001b[38;5;236m,\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[19G\u001b[22m])\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m68\u001b[11G\u001b[22m  \u001b[14G \u001b[38;5;125melif\u001b[38;5;236m config[\u001b[38;5;24m\"phase\"\u001b[38;5;236m] == \u001b[38;5;24m\"amendment\"\u001b[38;5;236m:\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m表單內容確認無誤：SF038\u001b[27G各節內容與\u001b[38GSF037\r\u001b[2C\u001b[1B的收案人數、分組、修正案次數及免除同意書資訊都正確帶入。接下來我會補寫自動化測試，驗證\u001b[90GSF038\r\u001b[1B  有正確帶入內容，並確保未填寫時顯示空白提示。\r\u001b[2C\u001b[2BView e2e test helpers\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m$ sed -n 30,60p tests/test_retrospective_e2e.py\u001b[39m\u001b[K\r\u001b[3C\u001b[2B\u001b[38;5;216mesticulating…\u001b[30G\u001b[38;5;241m20\u001b[33G1\u001b[42G)\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
