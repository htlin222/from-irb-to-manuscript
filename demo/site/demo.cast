[1275.610191, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39mOpenEvidence\u001b[16G的回答本身就前後矛盾（同一篇論文頁碼、作者數對不上），這證實需要獨立查證。接下來我會手動記錄約30篇文獻\r\u001b[1B \u001b[3G的DOI、第一作者和年份，透過程式交叉比對Crossref與PubMed的資料，並依官方資訊自動產生符合JCRP格式的參考文獻清單。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1w685y6;file:///Users/Shared/her2-neoadjuvant-study/manuscript/references.yaml\u0007manuscript/references.yaml\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote \u001b[1m179\u001b[22m lines to \u001b[1mmanuscript/references.yaml\r\u001b[1B\u001b[22m     \u001b[38;5;236m\u001b[2m  1 \u001b[22m\u001b[38;5;246m# 參考文獻清單（單一來源）。只手寫 DOI 與預期的第一作者／年份；書目內容一律由\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m2\u001b[12G\u001b[22m\u001b[38;5;246mmanuscript/verify_references.py 從 Crossref 與 PubMed 取得並互相比對，產生 references.bib。\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m3\u001b[12G\u001b[22m\u001b[38;5;246m來源：OpenE\u001b[24Gidence 查詢"]
[1275.61044, "o", "（2026-10-09；article id 見 found_via）。\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[12G\u001b[22m\u001b[38;5;246mrole\u001b[18G論文中用來支持什麼（給作者參考，引用前請讀原文摘要確認\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m- \u001b[38;5;31mkey:\u001b[38;5;236m \u001b[38;5;24mgianni2012neosphere\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[10G\u001b[22m \u001b[12G\u001b[38;5;31mdoi\u001b[17G10.1016\u001b[38;5;24m/S1470-2045(11)70336-9\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[12G\u001b[22m\u001b[38;5;31mexpect:\u001b[38;5;236m {\u001b[38;5;31mfirst_author:\u001b[38;5;236m \u001b[38;5;24mGianni\u001b[38;5;236m, \u001b[38;5;31myear:\u001b[38;5;236m \u001b[38;5;31m2012\u001b[38;5;236m}\r\u001b[7C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m\u001b[38;5;31mto\u001b[15Gi\u001b[17G:\u001b[38;5;236m \u001b[38;5;24mrct\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[12G\u001b[22m\u001b[38;5;31mr\u001b[14Gle:\u001b[38;5;236m \u001b[38;5;24mNeoSphere\u001b[38;5;236m \u001b[38;5;24m—\u001b[38;5;236m \u001b[38;5;24madding\u001b[38;5;236m \u001b[38;5;24mpertuzumab\u001b[38;5;236m \u001b[38;5;24mto\u001b[38;5;236m \u001b[38;5;24mtrastuzumab\u001b[38;5;236m \u001b[38;5;24m+\u001b[38;5;236m \u001b[38;5;24mdocetaxel\u001b[38;5;236m \u001b[38;5;24mincreased\u001b[38;5;236m \u001b[38;5;24mbre"]
