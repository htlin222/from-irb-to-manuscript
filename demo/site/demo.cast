[1977.121075, "o", ";5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m, new \u001b[38;5;125mor\u001b[38;5;236m old))[\u001b[38;5;31m0\u001b[38;5;236m].split())                     \r\u001b[5C\u001b[1B\u001b[38;5;29m 114 +\u001b[38;5;236m            changes.append({\u001b[38;5;24m\"section\"\u001b[38;5;236m: section, \u001b[38;5;24m\"subsection\"\u001b[38;5;236m: subsection, \u001b[38;5;24m\"snippet\"\u001b[38;5;236m: lead, \u001b[38;5;24m\"change\"\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;29m     +\u001b[38;5;236m first})                                                                                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 115 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[38;5;24m\"\\n\\n\"\u001b[38;5;236m.join(p \u001b[38;5;125mfor\u001b[38;5;236m p \u001b[38;5;125min\u001b[38;5;236m out \u001b[38;5;125mif\u001b[38;5;236m p) + \u001b[38;5;24m\"\\n\"\u001b[38;5;236m, changes\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 116 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 117 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m我會調整修訂版的建置流程：先產生標示版轉成PDF，逐頁定位每處修改所在頁碼，再把總覽表放進回覆信重新產生，並因頁數可能\r\u001b[2C\u001b[1B變動而重新"]
[1977.121204, "o", "核對頁碼。另外，我把原本寫在\u001b[38;5;105mbuild.R\u001b[39m裡的「Word轉PDF、逐頁讀取文字」功能抽成共用工具，讓兩支建置程式共用。\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;5;241m  ⎿  $ sed -n '/^pdf_dir <- /,/^counts <- /p;/^if (!is.na(counts\\$pages)) {/,/^}/p' manuscript/R/build.R\r\u001b[2B\u001b[38;5;174m·\u001b[3GSprouting… \u001b[26G\u001b[38;5;241m1\u001b[28G8\u001b[37G)\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
