[1662.877797, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m 45 +\u001b[38;5;236men_date <- function(x) {   # config.toml 的日期是「2026年11月16日」→ November 16, 2026               \r\u001b[5C\u001b[1B\u001b[38;5;29m 46 +\u001b[38;5;236m  d <- as.Date(gsub(\"(\\\\d{4})年(\\\\d{2})月(\\\\d{2})日\", \"\\\\1-\\\\2-\\\\3\", x))                             \r\u001b[5C\u001b[1B\u001b[38;5;29m 47 +\u001b[38;5;236m  sprintf(\"%s %d, %s\", month.name[as.integer(format(d, \"%m\"))], as.integer(format(d, \"%d\")), format(d\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m, \"%Y\"))  \u001b[22G           \u001b[34G \u001b[38G \u001b[40G           \u001b[52G                           \u001b[80G        \u001b[89G   \u001b[93G    \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[11G\u001b[38;5;236m}\u001b[13G \u001b[15G  \u001b[18G                                              \u001b[65G              \u001b[80G   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 49 \u001b[22m L(\"**Ethics approval:** The study was approved by the institutional review board (\", cfg$study$irb_no\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m ,\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 46 -\u001b[38;5;236m  \"; approved \", cfg$dates$irb_approval_date, \"; amendment approved \", cfg$amendment$approval_date"]
[1662.877985, "o", ",  \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 50 +\u001b[38;5;236m  \"; approved \", \u001b[48;5;157men_date(\u001b[48;5;194mcfg$dates$irb_approval_date\u001b[48;5;157m)\u001b[48;5;194m, \"; amendment approved \", \u001b[48;5;157men_date(\u001b[48;5;194mcfg$amendment\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m$approval_date\u001b[48;5;157m)\u001b[48;5;194m,                                                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 51 \u001b[22m   \") with a waiver of informed consent.\")\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 52 \u001b[22m L(\"**Conflicts of interest:** \", meta$conflicts_of_interest)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 53 \u001b[22m contrib <- vapply(meta$authors, function(a) sprintf(\"%s: %s\", a$name_en, paste(a$contributions, colla\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22mpse = \", \")), \"\")\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m發現表格欄寬是依最長標題分配，導致數字欄位被擠到斷行。我會改成依內容寬度分配欄寬，讓長標題自動換"]
[1662.878147, "o", "行即可。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[28C\u001b[2B\u001b[38;5;241m6\u001b[31G4\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
