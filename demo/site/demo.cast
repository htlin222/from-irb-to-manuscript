[927.585973, "o", "m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(w, g) vapply(\u001b[38;5;31m0\u001b[38;5;125m:\u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;125mfunction\u001b[38;5;236m(k) \u001b[38;5;31msum\u001b[38;5;236m(w[g \u001b[38;5;125m==\u001b[38;5;236m k])\u001b[38;5;125m^\u001b[38;5;31m2\u001b[38;5;236m \u001b[38;5;125m/\u001b[38;5;236m \u001b[38;5;31msum\u001b[38;5;236m(w[g \u001b[38;5;125m==\u001b[38;5;236m k]\u001b[38;5;125m^\u001b[38;5;31m2\u001b[38;5;236m), \u001b[38;5;31m0\u001b[38;5;236m)\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m 37 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 38 \u001b[22m \u001b[38;5;246m# 加權 KM：指定時間點的存活率與標準誤、5 年 RMST\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m...\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m 74 \u001b[22m       }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 75 \u001b[22m     }\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 76 \u001b[22m   } \u001b[38;5;125melse\u001b[38;5;236m \u001b[38;5;125mif\u001b[38;5;236m (method \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"match\"\u001b[38;5;236m) {\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;160m\u001b[48;5;224m 74 -\u001b[38;5;236m    m <- matchit(f, data = x, method = \"nearest\", caliper = 0.2, std.caliper = TRUE)                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 77 +\u001b[38;"]
