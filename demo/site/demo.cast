[563.510597, "o", "m104\u001b[14G\u001b[38;5;236mexpect_equal(receptor_positive(\u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"0\"\u001b[38;5;236m,\u001b[52G\u001b[38;5;24m\"1\"\u001b[38;5;236m,\u001b[57G\u001b[38;5;24m\"0.5\"\u001b[38;5;236m,\u001b[64G\u001b[38;5;24m\"90\"\u001b[38;5;236m,\u001b[70G\u001b[38;5;24m\"\"\u001b[38;5;236m),\u001b[75Gcutoff\u001b[82G\u001b[38;5;125m=\u001b[84G\u001b[38;5;31m1\u001b[38;5;236m),\u001b[88G\u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;31mFALSE\u001b[38;5;236m,\u001b[97G\u001b[38;5;31mTRUE\u001b[38;5;236m,\u001b[103G\u001b[38;5;31mFALSE\u001b[38;5;236m,\u001b[110G\u001b[38;5;31mTR\r\u001b[7C\u001b[1B\u001b[38;5;29m  \u001b[12G\u001b[38;5;31mUE\u001b[38;5;236m, \u001b[38;5;31mNA\u001b[38;5;236m))                        \u001b[45G                           \r\u001b[6C\u001b[1B\u001b[38;5;29m105\u001b[12G\u001b[38;5;236m})                                                                                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m共用定義的測試已擴充到25項並全數通過，資料檢查程式改為呼叫同一套共用定義取代原本重複撰寫的Ki-67整理邏輯。接下來會讓\r\u001b[2C\u001b[1B收案名單記錄化療組合，並加入「記錄程式版本」的共用功能。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;"]
[563.510614, "o", "241m⏺\u001b[3G\u001b[39mReuse parse_pct, extend cohort output, add provenance\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mimport pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mdef edit(path, a, b):\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mp = pathlib.Path(path); s = p.read_text()\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241massert s.count(a) == 1, (path, a); p.write_text(s.replace(a, b))\r\u001b[5C\u001b[1Bedit(\"analysis/R/validate_raw.R\", 'source(\"analysis/R/common.R\")\\n', \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m'source(\"analysis/R/common.R\")\\nsource(\"analysis/R/definitions.R\")…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
