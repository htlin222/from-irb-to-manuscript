[2133.968974, "o", "1B示的文字來搜尋。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Locating pages using\u001b[24Gdisplayed\u001b[34Gtext;\u001b[40Grebuild\u001b[48Grevision\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 - <<'EOF'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mimport pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp = pathlib.Path(\"manuscript/style/mark_changes.py\"); s = p.read_text()\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;241mfor a, b\u001b[15Gin [\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m('''def mark_paragraph(old, new):\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m\"\"\"Return (marked paragraph, snippet of the first change or None).\"\"\"\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241mif old == new:\r\u001b[5C\u001b[1Breturn new, None''', '''def mark_paragraph(old, new):\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m\"\"\"Re…\u001b[13G\u001b[39m\u001b[K\r\u001b[19C\u001b[2B\u001b[38;5;241m6\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
