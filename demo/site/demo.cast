[932.204668, "o", "mands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m找到了：「傳統多變項迴歸」（敏感度分析\u001b[42GS3）的公式寫錯，把治療組這個變項漏掉了，所以算不出治療效果。我把它補回去。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mIncluding\u001b[13Gtreatment\u001b[23Gin\u001b[26Gregression\u001b[37Gmodels\u001b[44Gand\u001b[48Grerunning\u001b[38;5;241m · 2s\r\u001b[1B  ⎿  $ python3 - <<'EOF'\u001b[26G\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;241mim\u001b[9Gort pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp = pathlib.Path(\"analysis/R/outcomes.R\"); s = p.read_text()\r\u001b[5C\u001b[1Bfor\u001b[10Ga, b \u001b[16Gn [\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m(' g <- glm(update(f, as.formula(paste(outcome, \"~ .\"))), data = x, family = binomial)',\r\u001b[5C\u001b[1B' g <- glm(update(f, as.formula(paste(outcome, \"~ dual + .\"))), data = x, family = binomial)'),\r\u001b[5C\u001b[1B(' c… (3s)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;241mctrl+b ctrl+b (twice) to run in background)\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
