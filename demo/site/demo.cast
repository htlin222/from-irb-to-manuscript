[1456.960329, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;5;16m⏺\u001b[3G\u001b[39m專案的 Python 環境沒有讀\u001b[28GYAML\u001b[33G的套件，R\u001b[43G倒是現成就有，所以查證程式改用\u001b[74GR\u001b[76G寫。\r\u001b[2B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1ozsmgz;file:///Users/Shared/her2-neoadjuvant-study/manuscript/verify_references.R\u0007manuscript/verify_references.R\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m96\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1mmanuscript/verify_references.R\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;5;236m\u001b[2m  1 \u001b[22m\u001b[38;5;246m# 參考文獻查證：manuscript/references.yaml 的每個 DOI 都向 Crossref 與 PubMed 查詢，\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  2 \u001b[22m\u001b[38;5;246m# 互相比對並與預期的第一作者／年份比對；通過者寫入 references.bib（書目全部來自官方資料庫）。\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m3\u001b[12G\u001b[22m\u001b[38;5;246m產出：manuscript/references.bib、manuscript/references_verification.csv。有任何一篇失敗則以非零狀態\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[10G\u001b[22m\u001b[38;5;246m結束。\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m"]
[1456.960461, "o", "4\u001b[12G\u001b[22m\u001b[38;5;246m執行\u001b[20Gke references\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m  library(yaml); library(jsonlite); library(data.table)\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m})\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[10G\u001b[22mrefs \u001b[38;5;125m<-\u001b[38;5;236m read_yaml(\u001b[38;5;24m\"manuscript/references.yaml\"\u001b[38;5;236m)\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22mua \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;24m\"her2-neoadjuvant-study reference check (R jsonlite)\"\r\u001b[5C\u001b[1B\u001b[38;5;241m… +104 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mVerifying all references\u001b[28Gagainst\u001b[36GCrossref\u001b[45Gand\u001b[49GPubMed\r\u001b[1B\u001b[38;5;241m  ⎿  $ Rscript -e 'cat(requireNamespace(\"curl\", quietly=TRUE), \"\\n\")' && time Rscript manuscript/verify_references.R \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m2>&1 | tail -40\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;174m✻\u001b[3G\u001b[38;5;216mCoalescing…\u001b[19G\u001b[38;5;241m8\u001b[29G4\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
