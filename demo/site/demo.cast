[786.876014, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[19B您說開始分析，我就當作您核定了分析計畫\u001b[42G1.0。正式跑結果之前，我先把分析計畫標成定稿、打上\u001b[92G\u001b[38;5;105msap-v1.0\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[786.882283, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✻\u001b[6G\u001b[38;5;216mu\u001b[9G\u001b[38;5;174mi\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
