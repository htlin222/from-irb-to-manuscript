[1629.394241, "o", "TML 自包含檔要在原位置產生，否則找不到 quarto 的元\u001b[38;5;236m \r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;246m件\u001b[38;5;236m                                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 31 +\u001b[38;5;236m  produced \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mif\u001b[38;5;236m (to \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"html\"\u001b[38;5;236m) file.path(\u001b[38;5;24m\"manuscript\"\u001b[38;5;236m, out) \u001b[38;5;125melse\u001b[38;5;236m out                                \r\u001b[5C\u001b[1B\u001b[38;5;29m 32 +\u001b[38;5;236m  argv \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"render\"\u001b[38;5;236m, file.path(\u001b[38;5;24m\"manuscript\"\u001b[38;5;236m, qmd), \u001b[38;5;24m\"--to\"\u001b[38;5;236m, to, \u001b[38;5;125mif\u001b[38;5;236m (to \u001b[38;5;125m!=\u001b[38;5;236m \u001b[38;5;24m\"html\"\u001b[38;5;236m) \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;24m\"--output\"\u001b[38;5;236m, out))\r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[13G\u001b[38;5;236mst \u001b[38;5;125m<-\u001b[38;5;236m system2(\u001b[38;5;24m\"quarto\"\u001b[38;5;236m, argv, stdout \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mlog\u001b[38;5;236m, stderr \u001b[38;5;"]
