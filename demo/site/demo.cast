[1669.924811, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;160m\u001b[48;5;224m  \u001b[11G\u001b[38;5;236m題自動換行                          \u001b[48G    \u001b[53G \u001b[55G               \u001b[71G    \u001b[78G \u001b[80G                                \r\u001b[6C\u001b[1B\u001b[38;5;160m46\u001b[11G\u001b[38;5;236m  w[1] <- max(w[1],\u001b[31G1.8)\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 45 +\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x, part = \"body\")$widths, 0.6)\u001b[48;5;157m + 0.12\u001b[48;5;194m   # 依內容（不依長標題）\u001b[48;5;157m決定\u001b[48;5;194m \r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m\u001b[48;5;157m欄寬並留緩衝\u001b[48;5;194m；標題自動換行          \u001b[48G    \u001b[53G \u001b[55G               \u001b[71G           \u001b[85G \u001b[87G                        \r\u001b[6C\u001b[1B\u001b[38;5;29m46\u001b[11G\u001b[38;5;236m  w[1] <- \u001b[48;5;157mmin(\u001b[48;5;194mmax(w[1], 1.\u001b[48;5;157m5\u001b[48;5;194m)\u001b[48;5;157m, 2.2)\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 47 \u001b[22m   flextable::width(x, width = w * min(1, page / sum(w)))\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[11G\u001b[22m}\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[11G\u001b[22mfootnotes <- function(t) knitr::asis_output(paste0(\"\\n\", paste(t$footnotes, collaps"]
[1669.924965, "o", "e = \"\\n\\n\"), \"\\n\")\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22m)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m三張表現在都清楚易讀了，Table\u001b[33G2\r\u001b[1B \u001b[3G的信賴區間偶爾分成兩行是可接受的。接下來我會跑全部測試和程式碼檢查，確認寫作指引裡的數字正確後存檔。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRunning\u001b[11Gtests,\u001b[18Glinting,\u001b[27Gand\u001b[31Gsanity-check\u001b[44Gthe\u001b[48Gwriting\u001b[56Gguide\u001b[38;5;241m · 2s\r\u001b[1B  ⎿  $ make test 2>&1 | tail -1; make test-analysis 2>&1 | grep definitions; make lint 2>&1 | tail -2; grep -o '2.01 \r\u001b[1B\u001b[39m     \u001b[38;5;241m(95% CI, 1.1\u001b[19G–3.62)' manuscript/_build/writing_guide.html | head -1; grep -c\u001b[83G'{{'\u001b[88G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mmanuscript/_build/writi\u001b[30Gg_gu\u001b[35Gde.html; git status --short (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m(ctrl+b c\u001b[16Grl+b (twice) to r\u001b[34Gn in background)\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
