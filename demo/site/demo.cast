[1628.199509, "o", "if (st != 0 || !file.exists(out)) stop(qmd, \" 產生失敗，請看 \", log)                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m 33 -\u001b[38;5;236m  file.rename(out, file.path(BUILD, out))                                                            \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m 30 +\u001b[38;5;236m  \u001b[38;5;246m# Word：--output 相對於執行目錄（專案根目錄）；HTML 自包含檔要在原位置產生，否則找不到 quarto 的元\u001b[38;5;236m \r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;246m件\u001b[38;5;236m                                                                                                   \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 31 +\u001b[38;5;236m  produced \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mif\u001b[38;5;236m (to \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;24m\"html\"\u001b[38;5;236m) file.path(\u001b[38;5;24m\"manuscript\"\u001b[38;5;236m, out) \u001b[38;5;125melse\u001b[38;5;236m out                                \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;29m\u001b[48;5;194m 32 +\u001b[38;5;236m  argv \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;31mc"]
