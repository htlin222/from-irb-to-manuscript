[1608.389413, "o", "ackageStartupMessages(library(data.table))\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22mword_count \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(x) {\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m  x \u001b[38;5;125m<-\u001b[38;5;236m gsub(\u001b[38;5;24m\"<!--.*?-->\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m, x)\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m  x \u001b[38;5;125m<-\u001b[38;5;236m gsub(\u001b[38;5;24m\"\\\\[@[^]]*\\\\]\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m, x)                         \u001b[38;5;246m# 引用\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[23G\u001b[22m\u001b[38;5;24m(?m)^#+ .*$\"\u001b[38;5;236m, \u001b[38G\u001b[38;5;24m\"\u001b[38;5;236m, x, perl \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31mTRUE\u001b[38;5;236m)             \u001b[38;5;246m# 小標題不計\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[23G\u001b[22m\u001b[38;5;24m[*_`#>\u001b[30G\"\u001b[38;5;236m, \u001b[38;5;24m\" \u001b[38G\u001b[38;5;236mx)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[12G\u001b[22m\u001b[38;5;31mlength\u001b[38;5;236m(Filter(\u001b[38;5;31mnzchar\u001b[38;5;236m, strsplit(trimws(x), \u001b[38;5;24m\"\\\\s+\"\u001b[38;5;236m)[[\u001b[38;5;31m1\u001b[38;5;236m]]))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m… +133 l"]
