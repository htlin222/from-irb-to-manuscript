[1358.295695, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mReceived \u001b[1m0 bytes\u001b[22m (402 Payment Required)\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m兩個官方網址都被網站的防護機制擋下。我改用更深入的搜尋，找其他地方轉載的投稿須知內容。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[39m \u001b[1mWeb Search\u001b[22m(\"Journal\u001b[23Gof Cancer Research and\u001b[46GPractice\u001b[55GTaiwan\u001b[62GOncology\u001b[71GSociety\u001b[79GWolters\u001b[87GKluwer\u001b[94GMedknow\u001b[102Ginstructions\r\u001b[12C\u001b[1Bauthors\u001b[21Goriginal\u001b[30Garticle\u001b[38Gwords\u001b[44Gabstract\u001b[53Greferences\")\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mDid 3 searches in 12s\u001b[K\r\u001b[2B\u001b[38;5;16m⏺\u001b[3G\u001b[39m期刊在 Medknow 平台還有一個網站 \u001b[38;5;105mejcrp.org\u001b[39m。Medknow 的網站通常把投稿須知放在\u001b[79G\u001b[38;5;105mcontributors.asp\u001b[39m，我直接抓這頁試試。\r\u001b[12C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[39m \u001b[1mFetch\u001b[22m(https://www.ejcrp.org/contributors.asp)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mReceived\u001b[15G\u001b[1m1.3KB\u001b[21G\u001b[22m(302\u001b[26GFound)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[38;5;105mejcrp.org\u001b[13G\u001b[39m也轉回"]
[1358.295824, "o", "原本被擋的\u001b[30Govid\u001b[35G網址。我改用一般瀏覽器的方式讀取這個公開頁面看看。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[39m Trying fetching author\u001b[26Ginstructions\u001b[39Gwith\u001b[44Ga\u001b[46Gbrowser\u001b[54Guser\u001b[59Gagent\r\u001b[1B\u001b[38;5;241m  ⎿  $ mkdir -p \"$TMPDIR/jcrp\" && cd \"$TMPDIR/jcrp\" && for u in \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m\"https://www.ovid.com/jnls/jcrp/pages/instructions-for-authors\" \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m\"https://journals.lww.com/jcrp/pages/informationforauthors.aspx\"; do code=$(curl -sL -o \"page_$(echo $u | md5 | \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mcut -c1-6).html\" -w '%{http_code} %{size_download}' -A 'Mozilla/…\r\u001b[7C\u001b[2B\u001b[38;5;174ming\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
