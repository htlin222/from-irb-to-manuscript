[1552.629945, "o", "\u001b[?25l\u001b[H\r\u001b[1B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=cchnj3;file:///Users/Shared/her2-neoadjuvant-study/manuscript/style/make_reference_docx.py\u0007manuscript/style/make_reference_docx.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m84\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1mmanuscript/style/make_reference_docx.py\r\u001b[2C\u001b[1B\u001b[22m   \u001b[38;5;236m\u001b[2m 1 \u001b[22m\u001b[38;5;24m\"\"\"Build the Word style template for JCRP submissions (manuscript/style/reference.docx).\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 2 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 3 \u001b[22mStarts \u001b[38;5;125mfrom\u001b[38;5;236m pandoc\u001b[38;5;24m's default reference.docx and applies manuscript/journal.yaml'\u001b[38;5;236ms \u001b[38;5;31mformat\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m 4 \u001b[22mrules that a style can carry: double spacing, \u001b[38;5;31m2.5\u001b[38;5;236m cm margins, page numbers at the bottom,\r\u001b[6C\u001b[1B\u001b[2m5\u001b[9G\u001b[22mTimes New Roman \u001b[38;5;31m12\u001b[38;5;236m pt, headings \u001b[38;5;125min\u001b[38;5;236m title \u001b[38;5;125mcase\u001b[38;5;236m \u001b[38;5;"]
[1552.630722, "o", "125mas\u001b[38;5;236m typed (no ALL CAPS, no theme colours).\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m6\r\u001b[6C\u001b[1B7\u001b[9G\u001b[22mUs\u001b[12Gge:\u001b[16Guv run python manuscript/style/make_reference_docx.py <pandoc-default.docx> <out.docx>\r\u001b[6C\u001b[1B\u001b[2m8\u001b[9G\u001b[22m\u001b[38;5;24m\"\"\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[9G\u001b[22m\u001b[38;5;125mimport\u001b[38;5;236m sys\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m… +74 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;5;241m  ⎿  $ uv run python manuscript/style/make_reference_docx.py \"$TMPDIR/pandoc-reference.docx\" \r\u001b[5C\u001b[1Bmanuscr\u001b[14Gpt/style/reference.docx && uv run python -c \"\r\u001b[5C\u001b[1Bfrom docx import Document; d = Document('manuscript/style/reference.docx'); s = d.sections[0]\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mprint('margins cm', round(s.top_margin.cm,2), round(s.left_marg…\r\u001b[2C\u001b[2B\u001b[38;5;216mGar\u001b[13G\u001b[38;5;174m…\u001b[20G\u001b[38;5;241m3\u001b[30G4\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
