[1065.120915, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;5;174m✢\u001b[14G\u001b[38;5;216mg\u001b[23G\u001b[38;5;246mthinking with high effort\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
