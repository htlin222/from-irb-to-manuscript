[222.293897, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;29m\u001b[48;5;194m7\u001b[13G\u001b[38;5;236m審查類別：簡易審查\u001b[32G    \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[17G\u001b[38;5;236m結果\u001b[23G**修正後複審**\r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m \u001b[13G                        \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m##\u001b[14G審查意見\r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[11G\u001b[38;5;236m  \u001b[14G        \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[11G\u001b[38;5;236m1.\u001b[14G本研究比較不同年代所使用之治療。請說明年代差異（例如支持性照護進步、術後治療改變）可能造成之干擾，\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m以及計畫如何處理。                                                                                   \r\u001b[6C\u001b[1B\u001b[38;5;29m13\u001b[11G\u001b[38;5;236m2. 請說明預計收案人數之依據，或提供檢定力（power）評估。\r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[11G\u001b[38;5;236m3\u001b[16G具體說明去識別化流程：病歷號與研究編號對照表由何人保管、存放於何處、研究結束後如何銷毀。\r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[11G\u001b[38;5;236m4\u001b[14G主要終點「無事件存"]
[222.294393, "o", "活（EFS）」之定義不明確，請說明起算時間點及納入之事件種類。             \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[11G\u001b[38;5;236m5\u001b[14G研究資料之保存年限請明列於計畫書。                                           \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[11G\u001b[38;5;236m  \u001b[14G                                  \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[11G\u001b[38;5;236m請於收到通知後\u001b[26G30\u001b[29G日內，檢附「審查意見回覆表」及修正後文件提出複審。\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m審查意見原文解析時黏成整段，無法逐條讀取，我改成在回覆檔中每條先引用原文再寫回覆，並自動產生回覆表。接下來我先查看表\r\u001b[1B \u001b[3G格寬度的設定工具。\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mSearched for \u001b[1m1\u001b[22m pattern, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[39m \u001b[1mWrite\u001b[22m(\u001b]8;id=e96wkj;file:///Users/Shared/her2-neoadjuvant-study/correspondence/IRB%E5%88%9D%E5%AF%A9_%E5%9B%9E%E8%A6%86.md\u0007corresponden"]
