[266.018001, "o", "      \u001b[38;5;246m# 原審查日期；IRB 通知未載明，留白待填\u001b[38;5;236m                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 71 +\u001b[38;5;31mresponses\u001b[38;5;236m      = \u001b[38;5;24m\"@correspondence/IRB初審_回覆.md\"\u001b[38;5;236m   \u001b[38;5;246m# ## 意見 N：審查意見原文 + 回覆\u001b[38;5;236m                \r\u001b[1B\u001b[49m\u001b[38;5;241m  ⎿  \u001b[39mUpdat\u001b[12Gd \u001b[1mscripts/generators/re_review.py\u001b[22m \u001b[38;5;241m(+1 -1)\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 100 \u001b[22m     original = rr.get(\u001b[38;5;24m\"original_phase\"\u001b[38;5;236m, \u001b[38;5;24m\"\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[2m 101 \u001b[22m     known = original \u001b[38;5;125min\u001b[38;5;236m ORIGINAL_TYPES\r\u001b[5C\u001b[1B\u001b[2m 102 \u001b[22m     types = \u001b[38;5;24m\"　\"\u001b[38;5;236m.join(\u001b[38;5;24mf\"\u001b[38;5;236m{check(original == k)}\u001b[38;5;24m \u001b[38;5;236m{v}\u001b[38;5;24m\"\u001b[38;5;236m \u001b[38;5;125mfor\u001b[38;5;236m k, v \u001b[38;5;125min\u001b[38;5;236m ORIGINAL_TYPES.items())\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 103 -\u001b[38;5;236m    other = ORIGINAL_TYPES.get(original) or original if not known else \"\"                     "]
