[1165.502429, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[21B\u001b[38;5;174mi\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1165.52057, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m我發現\u001b[10GSF015\u001b[16G的修正資訊需手動填寫、SF016\u001b[44G對照表目前是空白的，容易出錯又重複記錄事實。我會改讓\u001b[97GSF016\u001b[103G自動比對\u001b[112GIRB\r\u001b[1B \u001b[3G核准版與修正後的計畫摘要列出差異，現在先開新分支並修改計畫摘要。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m⏺\u001b[3G\u001b[39m重新檢查核准版計畫時，我發現分析用到的\u001b[42GBMI\u001b[46G和基期心臟功能（LVEF）並未列入「資料收集項目」，雖然資訊室有提供這兩欄位\r\u001b[2C\u001b[1B，依規定仍需一併補上。接下來我會修改計畫摘要的四個段落。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRevise\u001b[10Gprotocol\u001b[19Gsummary\u001b[27Gsections\u001b[36Gfor\u001b[40Gthe\u001b[44Gamendment\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241mimport pathlib, re\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp = pathlib.Path(\"中文計畫摘要.md\"); s = p.read_text()\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;241mdef s\u001b"]
[1165.520692, "o", "[12Gction(n\u001b[20Gme, body):\r\u001b[5C\u001b[1Bglobal s\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mpat = re.compile(r\"(## %s\\n\\n)(.*?)(\\n\\n## )\" % re.escape(name), re.S)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;241massert len(pat.findall(s)) == 1, name\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241ms = pat.sub(lambda m: m.group(1) + body.strip() + m.group(3), s)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241msec…\u001b[11G\u001b[39m\u001b[K\r\u001b[4C\u001b[2B\u001b[38;5;216mithering…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1165.522795, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[21B\u001b[38;5;174mSlithering…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1165.545362, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236m衡。                                                                                                 \r\u001b[5C\u001b[1B\u001b[38;5;160m 55 -\u001b[38;5;236mpCR以加權邏輯斯迴歸估計勝算比；EFS與OS以Kaplan-Meier法及加權Cox模型估計風險比（穩健標準誤）。        \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m 56 -\u001b[38;5;236m敏感度分析：限縮於兩種治療並行之年份、傾向分數配對、EFS依術後是否使用T-DM1分層、E-value；缺失值以多重\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236m插補處理。                                                                                           \r\u001b[5C\u001b[1B\u001b[38;5;160m 57 -\u001b[38;5;236m樣本數依據：納入期間內全部符合條件者（資訊室初估600–700人）。依NeoSphere試驗pCR約29%對46%，即使兩組比\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236m為1:3，檢定力仍逾95%；                                                         "]
[1165.545499, "o", "                      \r\u001b[5C\u001b[1B\u001b[38;5;160m 58 -\u001b[38;5;236m若真實差距僅10個百分點，檢定力約57–77%。EFS與OS不作正式檢定力宣稱。雙尾p<0.05為顯著，使用R 4.5；無期 \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236m中分析。                                                                                             \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 54 +\u001b[38;5;236m傾向分數共變項含年齡、\u001b[48;5;157m停經狀態、ECOG、BMI、LVEF、\u001b[48;5;194m臨床T/N分期、荷爾蒙受體、\u001b[48;5;157mHER2判定方式、\u001b[48;5;194m組織學分級、\u001b[48;5;157mK\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236m\u001b[48;5;157mi-67、\u001b[48;5;194m化療方案及治療年份\u001b[48;5;157m；重疊加權後以SMD\u001b[48;5;194m<0.1判定平衡。                                              \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 55 +\u001b[38;5;236mpCR以加權邏輯斯迴歸估計勝算比並報告風險差；EFS與OS以加權Kaplan-Meier法及加權Cox模型估計風險"]
[1165.545658, "o", "比（穩健標\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236m準誤）。缺失值以多重插補處理（不納入結果變項）。                                                     \r\u001b[5C\u001b[1B\u001b[38;5;29m 56 +\u001b[38;5;236m敏感度分析：限縮於兩種治療並行之年份、傾向分數配對、多變項迴歸、pCR改採ypT0 ypN0、完整個案分析、E-val\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236mue；術後T-DM1使用比例僅作描述。探索性次族群：荷爾蒙受體。                                            \r\u001b[5C\u001b[1B\u001b[38;5;29m 57 +\u001b[38;5;236m樣本數依據：納入期間內全部符合條件者。因重疊加權後有效樣本數約150人，依NeoSphere試驗pCR約29%對46%估計\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m檢定力約60%，結果以效應值及95%信賴區間為主。                                                         \r\u001b[5C\u001b[1B\u001b[38;5;29m 58 +\u001b[38;5;236mEFS與OS不作正式檢定力宣稱。雙尾p<0.05為顯著，使用R 4.5；無期中分析。                              "]
[1165.545816, "o", "   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 59 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 60 \u001b[22m ## 資料保護\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 61 \u001b[22m \r\u001b[2B\u001b[38;5;174m✻\u001b[28G\u001b[38;5;241m8\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
