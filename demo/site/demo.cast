[1172.43352, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236m檢定力約60%，結果以效應值及95%信賴區間為主。                                                         \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[11G\u001b[38;5;236mEFS與OS不作正式檢定力宣稱。雙尾p<0.05為顯著，使用R 4.5；無\u001b[71G中分析。                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 59 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 60 \u001b[22m ## 資料保護\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 61 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m計畫摘要已修改完成，共4段。接下來我會調整產生表單的程式：讓SF015自動勾選修正原因並填上「第1次修正」，並讓SF016自動比\r\u001b[2C\u001b[1B對核准版與修正版，逐段標示修改內容（刪除畫刪除線、新增畫底線）。\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mExtend SF015/SF016 generators and amendment form list\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 - <<'EOF'\r\u001b[5C\u001b[1Bimport pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mp = pathlib.Path(\"scripts/generators/amendment.py\""]
