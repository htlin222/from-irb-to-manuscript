[1456.822078, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote \u001b[1m179\u001b[16G\u001b[22mlines to \u001b[1mmanuscript/references.yaml\u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  1 \u001b[22m\u001b[38;5;246m# 參考文獻清單（單一來源）。只手寫 DOI 與預期的第一作者／年份；書目內容一律由\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m\u001b[38;5;246m# manuscript/verify_references.py 從 Crossref 與 PubMed 取得並互相比對，產生 references.bib。\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  3 \u001b[22m\u001b[38;5;246m# 來源：OpenEvidence 查詢（2026-10-09；article id 見 found_via）。\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  4 \u001b[22m\u001b[38;5;246m# role：論文中用來支持什麼（給作者參考，引用前請讀原文摘要確認）。\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m- \u001b[38;5;31mkey:\u001b[38;5;236m \u001b[38;5;24mgianni2012neosphere\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[10G\u001b[22m  \u001b[38;5;31mdoi:\u001b[38;5;236m \u001b[38;5;31m10.1016\u001b[38;5;24m/S1470-2045(11)70336-9\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[10G\u001b[22m  \u001b[38;5;31mexpect:\u001b[38;5;"]
[1456.822409, "o", "236m {\u001b[38;5;31mfirst_author:\u001b[38;5;236m \u001b[38;5;24mGianni\u001b[38;5;236m, \u001b[38;5;31myear:\u001b[38;5;236m \u001b[38;5;31m2012\u001b[38;5;236m}\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[10G\u001b[22m  \u001b[38;5;31mtopic:\u001b[38;5;236m \u001b[38;5;24mrct\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[10G\u001b[22m \u001b[12G\u001b[38;5;31mrole:\u001b[38;5;236m \u001b[38;5;24mNeoSphere\u001b[38;5;236m \u001b[38;5;24m—\u001b[38;5;236m \u001b[38;5;24madding\u001b[38;5;236m \u001b[38;5;24mpertuzumab\u001b[38;5;236m \u001b[38;5;24mto\u001b[38;5;236m \u001b[38;5;24mtrastuzumab\u001b[38;5;236m \u001b[38;5;24m+\u001b[38;5;236m \u001b[38;5;24mdocetaxel\u001b[38;5;236m \u001b[38;5;24mincreased\u001b[38;5;236m \u001b[38;5;24mbreast\u001b[38;5;236m \u001b[38;5;24mpCR\u001b[38;5;236m \u001b[38;5;24m(29%\u001b[38;5;236m \u001b[38;5;24mto\u001b[38;5;236m \u001b[38;5;31m46\u001b[38;5;24m%)\r\u001b[5C\u001b[1B\u001b[38;5;241m… +172 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m專案的 Python 環境沒有讀\u001b[28GYAML\u001b[33G的套件，R\u001b[43G倒是現成就有，所以查證程式改用\u001b[74GR\u001b[76G寫。\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1ozsmgz;file:///Users/Shared/her2-neoad"]
