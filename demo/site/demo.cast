[262.445102, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✳\u001b[27G\u001b[38;5;241m7\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[262.458918, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m  \u001b[11G\u001b[22m衡。\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 51 -\u001b[38;5;236mpCR以加權邏輯斯迴歸估計勝算比（未接受手術者視為未達pCR）；EFS與OS以Kaplan-Meier法及加權Cox模型估計風 \r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m險比（穩健標準誤）。                                                                                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 55 +\u001b[38;5;236mpCR以加權邏輯斯迴歸估計勝算比；EFS與OS以Kaplan-Meier法及加權Cox模型估計風險比（穩健標準誤）。        \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 56 \u001b[22m 敏感度分析：限縮於兩種治療並行之年份、傾向分數配對、EFS依術後是否使用T-DM1分層、E-value；缺失值以多重\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m 插補處理。\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 53 -\u001b[38;5;236m依NeoSphere試驗pCR約29%對46%，總數650–700人時即使兩組比為1:3，檢定力仍逾90%。雙尾p<0.05為顯著，使用R \r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m4.5；無期中分析。     "]
[262.459131, "o", "                                                                               \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 57 +\u001b[38;5;236m樣本數依據：納入期間內全部符合條件者（資訊室初估600–700人）。依NeoSphere試驗pCR約29%對46%，即使兩組比\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m為1:3，檢定力仍逾95%；                                                                               \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[11G\u001b[38;5;236m若真實差距僅10個百分點，檢定力約57–77%。EFS與OS不作正式檢定力宣稱。雙尾p<0.05為顯著，使用R 4.5；無期 \r\u001b[10C\u001b[1B中分析。              \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m                                                                                          \u001b[102G         \r\u001b[5C\u001b[1B\u001b[49m\u001b[38;5;241m… 8 more lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m接著改程式：讓 SF019\u001b[24G回覆表自動讀取回覆檔，並讓計畫摘要能帶入「資料保護」這一段文字。\r\u001b[2B\u001b[38;5;241m⏺\u001b[3G\u001b[39mReading proposa"]
