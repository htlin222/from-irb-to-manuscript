[888.890348, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[19B我把可能出錯的地方分成「方法本身的限制」和「可以實際查證的疑點」兩類。後者我現在就直接用資料檢查，不靠猜。這些都是事\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[888.898463, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✶\u001b[4G\u001b[38;5;216mr\u001b[7G\u001b[38;5;174mv\u001b[15G\u001b[38;5;241m9\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
