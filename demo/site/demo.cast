[1076.793394, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;5;174m✢\u001b[19G\u001b[38;5;241m1\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1076.804684, "o", "\u001b[?25l\u001b[H\r\u001b[13B\u001b[38;5;241m⏺\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1076.820303, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;5;174m·\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1076.831964, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m我會從乾淨的狀態完整重跑一次，再和存檔的結果逐一比對。為了避免受我電腦上任何沒存檔的東西影響，做法是：\r\u001b[2C\u001b[1B1\u001b[6G另外開一個乾淨的工作副本\u001b[32G內容就是目前存檔的版本，不含任何中間產物。\r\u001b[2C\u001b[1B2\u001b[6G原始資料用唯讀連結指過去，不另外複製病人資料。\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G執行\u001b[11G\u001b[38;5;105mmake analysis\u001b[39m，再把每個結果檔和存檔版本逐一比對。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B我還會多做一個更嚴格的測試：如果在另一台電腦上重跑，沒有我們的病歷號對照表，研究編號會重新隨機產生，結果還會一樣嗎？\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m原來是因為 \u001b[38;5;105mdata/raw/\u001b[39m 資料夾已存在且含有指紋清單，我建的連結被放錯位置導致找不到原始檔，而非資料本身有問題，驗證機制\r\u001b[2C\u001b[1B也"]
[1076.832111, "o", "確實正確攔下了這個錯誤。我會改為逐一連結每個原始檔，並用版本紀錄中的指紋清單來核對。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[39m Link raw files individually and rerun clean analysis\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ R1=\"$TMPDIR\u001b[20Gr\u001b[23Gun1\"; cd \"$R1\" && rm -f data\u001b[52Graw/raw && for f in \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m/Users/Shared/her2-neoadjuvant-study/data/raw/*;\u001b[55Gdo\u001b[58Gb=$(basename \"$f\"); [ \"$b\" = MANIFEST.sha256\u001b[103G] || ln -s \"$f\" \r\u001b[5C\u001b[1B\"data/raw/$b\";\u001b[21Gdone\u001b[26G&& git -C \"$R1\" diff --quiet -- data/raw/MANIFEST.sha256 && echo \"MANIFEST = committed \r\u001b[5C\u001b[1Bversion\" && l…\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1076.834192, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[20B\u001b[38;5;216mSock-hopping…\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1076.876506, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;5;174m✢\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
