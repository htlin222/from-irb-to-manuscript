[811.22154, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m275\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1manalysis/R/outcomes.R\r\u001b[2C\u001b[1B\u001b[22m   \u001b[38;5;236m\u001b[2m  1 \u001b[22m\u001b[38;5;246m# 主分析與敏感度分析（依 analysis/SAP.md v1.0，tag sap-v1.0）。\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m\u001b[38;5;246m# 輸入 data/derived/analysis.csv；輸出 results/outcomes_*.csv 與 results/figures/（km_*, love_plot）。\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  3 \u001b[22msource(\u001b[38;5;24m\"analysis/R/common.R\"\u001b[38;5;236m)\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  4 \u001b[22msource(\u001b[38;5;24m\"analysis/R/definitions.R\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22msuppressPackageStartupMessages({\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m  library(mice); library(WeightIt); library(MatchIt); library(cobalt)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[10G\u001b[22m  library(survival); library(sandwich); library(EValue); library(ggplot2); library(patchwork)\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m})\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[10G\u001b[22mp\u001b[12G\u001b[38;"]
[811.221688, "o", "5;125m<-\u001b[38;5;236m p\u001b[18Gams()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m… +297 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m傾向分數配對那段出錯是因為變異數矩陣缺少欄位名稱，我改用位置取值來修正。另外配對時出現的「控制組人數較少」警告屬預期\r\u001b[2C\u001b[1B情況（雙標靶組人數較多本就有配不到的），我已將其抑制以免干擾輸出。\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[26C\u001b[2B\u001b[38;5;241m3\u001b[29G4\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
