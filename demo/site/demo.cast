[816.09576, "o", "                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 79 \u001b[22m     md \u001b[38;5;125m<-\u001b[38;5;236m as.data.table(match.data(m))\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m80\u001b[15G\u001b[22mout\u001b[38;5;125m$\u001b[38;5;236mn\u001b[21G\u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;31mc\u001b[38;5;236m(\u001b[38;5;31msum\u001b[38;5;236m(md\u001b[38;5;125m$\u001b[38;5;236mdual \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;31m0\u001b[38;5;236m), \u001b[38;5;31msum\u001b[38;5;236m(md\u001b[38;5;125m$\u001b[38;5;236mdual \u001b[38;5;125m==\u001b[38;5;236m \u001b[38;5;31m1\u001b[38;5;236m)); out\u001b[38;5;125m$\u001b[38;5;236mess \u001b[38;5;125m<-\u001b[38;5;236m out\u001b[38;5;125m$\u001b[38;5;236mn\r\u001b[7C\u001b[1B\u001b[2m1\u001b[15G\u001b[22mg_or \u001b[38;5;125m<-\u001b[38;5;236m glm(reformul\u001b[36Gte(\u001b[38;5;24m\"dual\"\u001b[38;5;236m, outcome),\u001b[57Gdata \u001b[38;5;125m=\u001b[38;5;236m md, family \u001b[38;5;125m=\u001b[38;5;236m quasibinomial, weights \u001b[38;5;125m=\u001b[38;5;236m weights)\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m合併多重插補結果時出現缺值，代表某一個分析算出了空的估計值。我把各分析拆開檢查，找出是哪一個。\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B"]
