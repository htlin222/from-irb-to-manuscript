[1669.519374, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m43\u001b[11G\u001b[22m#\u001b[13G縮放欄寬到頁寬（A4 扣掉 2.5 cm 邊界約\u001b[51G6.3 吋），字體維持 10 p\u001b[75G，必要時換行（fit_to_width 會縮小字體\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22m）\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 44 \u001b[22m fit_page <- function(x, page = 6.3) {\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 45 -\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x, part = \"body\")$widths, 0.6)   # 依內容（不依長標題）決定欄寬；標\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m題自動換行                                                                                           \r\u001b[5C\u001b[1B\u001b[38;5;160m 46 -\u001b[38;5;236m  w[1] <- max(w[1], 1.8)                                                                             \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 45 +\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x, part = \"body\")$widths, 0.6)\u001b[48;5;157m + 0.12\u001b[48;5;194m   # 依內容（不依長標題）\u001b[48;5;157m決定\u001b[48;5;194m \r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m\u001b[48;5;157m欄寬並留緩衝\u001b[48;5;194m；標題"]
[1669.519541, "o", "自動換行                                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 46 +\u001b[38;5;236m  w[1] <- \u001b[48;5;157mmin(\u001b[48;5;194mmax(w[1], 1.\u001b[48;5;157m5\u001b[48;5;194m)\u001b[48;5;157m, 2.2)\u001b[48;5;194m                                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 47 \u001b[22m   flextable::width(x, width = w * min(1, page / sum(w)))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 48 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 49 \u001b[22m footnotes <- function(t) knitr::asis_output(paste0(\"\\n\", paste(t$footnotes, collapse = \"\\n\\n\"), \"\\n\")\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m )\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[39m 三張表現在都清楚易讀了，Table\u001b[33G2\r\u001b[2C\u001b[1B的信賴區間偶爾分成兩行是可接受的。接下來我會跑全部測試和程式碼檢查，確認寫作指引裡的數字正確後存檔。\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1669.52142, "o", "\u001b[?25l\u001b[H\r\u001b[20C\u001b[22B\u001b[38;5;241m5\u001b[43Gthought for 5s)\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1669.52338, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✻\u001b[31G\u001b[38;5;241m5\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1669.536689, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;174m✶\u001b[4G\u001b[38;5;216ma\u001b[7G\u001b[38;5;174mi\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
[1669.546327, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m 45 -\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x, part = \"body\")$widths, 0.6)   # 依內容（不依長標題）決定欄寬；標\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236m題自動換行                                                                                           \r\u001b[5C\u001b[1B\u001b[38;5;160m 46 -\u001b[38;5;236m  w[1] <- max(w[1], 1.8)                                                                             \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 45 +\u001b[38;5;236m  w <- pmax(flextable::dim_pretty(x, part = \"body\")$widths, 0.6)\u001b[48;5;157m + 0.12\u001b[48;5;194m   # 依內容（不依長標題）\u001b[48;5;157m決定\u001b[48;5;194m \r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m\u001b[48;5;157m欄寬並留緩衝\u001b[48;5;194m；標題自動換行                                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 46 +\u001b[38;5;236m  w[1] <- \u001b[48;5;157mmin(\u001b[48;5;194mmax(w[1], 1.\u001b[48;5;157m5\u001b[48;5;194m)\u001b[48;5;157m, 2.2)\u001b[48;5;194m                                                                   \r"]
[1669.54645, "o", "\u001b[5C\u001b[1B\u001b[49m\u001b[2m 47 \u001b[22m   flextable::width(x, width = w * min(1, page / sum(w)))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 48 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 49 \u001b[22m footnotes <- function(t) knitr::asis_output(paste0(\"\\n\", paste(t$footnotes, collapse = \"\\n\\n\"), \"\\n\")\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22m)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  (timeout 10m)\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m三張表現在都清楚易讀了，Table\u001b[33G2\r\u001b[2C\u001b[1B的信賴區間偶爾分成兩行是可接受的。接下來我會跑全部測試和程式碼檢查，確認寫作指引裡的數字正確後存檔。\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39mRunning tests, linting, and sanity-check\u001b[44Gthe\u001b[48Gwriting\u001b[56Gguide\r\u001b[1B\u001b[38;5;241m  ⎿  $ make test 2>&1 | tail -1; make test-analysis 2>&1 | grep definitions; make lint 2>&1 | tail -2; grep -o '2.01 \r\u001b[5C\u001b[1B(95% CI, 1.12–3.62)' manuscript/_build/writing_guide.html | head -1; grep -c '{{' \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mmanuscript/_build/writing_"]
