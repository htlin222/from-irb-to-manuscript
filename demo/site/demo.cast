[1278.452696, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m專案的 Python 環境沒有讀 YAML 的套件，R 倒是現成就有，所以查證程式改用 R 寫。\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1ozsmgz;file:///Users/Shared/her2-neoadjuvant-study/manuscript/verify_references.R\u0007manuscript/verify_references.R\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mWrote \u001b[1m96\u001b[22m lines to \u001b[1mmanuscript/verify_references.R\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;5;236m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;5;246m# 參考文獻查證：manuscript/references.yaml 的每個 DOI 都向 Crossref 與 PubMed 查詢，\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;5;246m# 互相比對並與預期的第一作者／年份比對；通過者寫入 references.bib（書目全部來自官方資料庫）。\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m3\u001b[10G\u001b[22m\u001b[38;5;246m# 產出：manuscript/references.bib、manuscript/references_verification.csv。有任何一篇失敗則以非零狀態\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m  \u001b[10G\u001b[22m\u001b[38;"]
[1278.452835, "o", "5;246m結束。\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  4 \u001b[22m\u001b[38;5;246m# 執行：make references\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  6 \u001b[22m  library(yaml); library(jsonlite); library(data.table)\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m  7 \u001b[22m})\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  9 \u001b[22mrefs \u001b[38;5;125m<-\u001b[38;5;236m read_yaml(\u001b[38;5;24m\"manuscript/references.yaml\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 10 \u001b[22mua \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;24m\"her2-neoadjuvant-study reference check (R jsonlite)\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241m… +104 lines \u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
