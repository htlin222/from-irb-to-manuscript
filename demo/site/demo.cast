[1560.612835, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m  4 \u001b[22msource(\u001b[38;5;24m\"analysis/R/common.R\"\u001b[38;5;236m)   \u001b[38;5;246m# study_facts()\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  5 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  7 \u001b[22mfmt_ci \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(est, lo, hi, d \u001b[38;5;125m=\u001b[38;5;236m \u001b[38;5;31m2\u001b[38;5;236m) sprintf(paste0(\u001b[38;5;24m\"%.\"\u001b[38;5;236m, d, \u001b[38;5;24m\"f (95%% CI, %.\"\u001b[38;5;236m, d, \u001b[38;5;24m\"f–%.\"\u001b[38;5;236m, d, \u001b[38;5;24m\"f)\"\u001b[38;5;236m), \r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m    \u001b[22mest, lo, hi)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[10G\u001b[22mfmt_p \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(p) \u001b[38;5;125mif\u001b[38;5;236m (p \u001b[38;5;125m>=\u001b[38;5;236m \u001b[38;5;31m0.001\u001b[38;5;236m) sprintf(\u001b[38;5;24m\"*P* = %.3f\"\u001b[38;5;236m, p) \u001b[38;5;125melse\u001b[38;5;236m sprintf(\u001b[38;5;24m\"*P* = %s\"\u001b[38;5;236m, formatC(p, form\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mfmt_n_of \u001b[38;5;125m<-\u001b[38;5;236m \u001b[38;5;125mfunction\u001b[38;5;236m(k, n) sprintf(\u001b[38;5;24m\"%d/%d (%.1f%%)\"\u001b[38;5;236m, k, n, \u001b[38;5;31m100\u001b[38;5;236m \u001b[38;5;125m*\u001b[38"]
