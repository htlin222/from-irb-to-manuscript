[283.292971, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m 160 +\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m \u001b[38;5;24m\"■ 新案\"\u001b[38;5;236m \u001b[38;5;125min\u001b[38;5;236m text                                                                         \r\u001b[5C\u001b[1B\u001b[38;5;29m 161 +\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m \u001b[38;5;24m\"■ 其他（請說明）：中文計畫摘要\"\u001b[38;5;236m \u001b[38;5;125min\u001b[38;5;236m text                                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 162 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 163 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 164 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_proposal_appends_data_protection_prose\u001b[38;5;236m(\u001b[38;5;31moutput_dir\u001b[38;5;236m):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m138\u001b[7G個測試全部通過；\u001b[38;5;105mmake test\u001b[33G\u001b[39m失敗是因為虛擬環境裡的路徑指向舊資料夾位置。我現在重建虛擬環境來修正。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan"]
[283.293362, "o", " \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[38;5;105mmake test\u001b[13G\u001b[39m現在\u001b[18G138\u001b[22G項全部通過，程式碼格式檢查也通過。接著用模擬審查跑一次複審文件。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m逐项核对后发现：缺SF005和SF019的「请说明」字样都是审查程序误判（复审不需重送SF005，且该字样本来就是表单栏位文字），\r\u001b[1B \u001b[3G只有「IRB编号空白」是真的需要您补充。现在我把这次的修改存档。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[23C\u001b[2B\u001b[38;5;241m9\u001b[26G3\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
