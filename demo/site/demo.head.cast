[262.403275, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;174m✻\u001b[4G\u001b[38;5;216mu\u001b[7G\u001b[38;5;174mi\u001b[27G\u001b[38;5;241m6\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
