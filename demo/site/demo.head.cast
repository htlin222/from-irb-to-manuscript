[134.167291, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m字型已裝好，但 LibreOffice 仍未套用，因為 Word 檔裡的字型名稱「DFKai-SB／標楷體」和\u001b[87GMac\r\u001b[2C\u001b[1B版名稱「BiauKaiTC／標楷體-繁」對不上。接下來我要查轉檔程式是怎麼處理字型名稱的。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39m我先在轉檔用的\u001b[18GLibreOffice\u001b[30G設定裡加一張「字型替換表」（遇到標楷體就改用\u001b[75GBiauKaiTC），試試看有沒有效。\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m⏺\u001b[3G\u001b[39mLibreOffice\u001b[15G認得的名稱是「標楷體-繁」。我把替換表改用這個名稱。\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m⏺\u001b[39m Map 標楷體 to 標楷體-繁 and reconvert\u001b[41GPDFs\r\u001b[1B\u001b[38;5;241m  ⎿  $ P=$(python3 -c \"import \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241mtempfi\u001b[13Ge;pr\u001b[18Gnt(tempfile.g\u001b[32Gttempdir())\")/irb-in-hu"]
[134.167442, "o", "rry-lo-profile/user/registrymodifications.xcu; sed -i '' \r\u001b[5C\u001b[1B's#<value>BiauKaiTC</v\u001b[29Glue>#<value>標楷體-繁</value>#g' \"$P\"; grep -c '標楷體-繁' \"$P\"; cd \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;241m/Users/Sha\u001b[17Ged/her2-n\u001b[27Goadjuva\u001b[35Gt-study && make pdf validate > \"$TMPDIR/make.log\" 2>&1; …\u001b[39m\u001b[28;1H\u001b[26;3H\u001b[?25h"]
