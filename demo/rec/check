#!/usr/bin/env bash
# Chapter checks, run from the study working directory (see stages.toml).
#   check answered ID        the turn that received prompt ID has ended (Stop hook)
#   check edited ID PREV     ...and the study repo differs from when PREV ended
#   check saved WORD         a git tag or commit message contains WORD
#   check branch-not-main    work is happening on a branch
#   check file GLOB...       at least one file matches any GLOB (** recursive)
#   check count N GLOB...    at least N files match
#   check raw-intake         4 CSVs in data/raw, a checksum manifest, and no CSV in git
#   check fp                 fingerprint of the repo state (HEAD + working tree)
S="${DEMO_STATE:?}"
fp() {
  { git rev-parse HEAD 2>/dev/null; git status --porcelain 2>/dev/null; git diff 2>/dev/null; } | cksum | cut -d' ' -f1
}
count() {
  python3 - "$@" <<'PY'
import glob, sys
hits = set()
for g in sys.argv[1:]:
    hits.update(p for p in glob.glob(g, recursive=True))
print(len(hits))
PY
}
case "$1" in
  fp)       fp ;;
  answered) test -f "$S/answered/$2" ;;
  edited)   test -f "$S/answered/$2" && [ "$(fp)" != "$(cat "$S/fp-$3" 2>/dev/null)" ] ;;
  saved)    { git tag -l -n99; git log --all --format='%s%n%b'; } 2>/dev/null | grep -q -- "$2" ;;
  branch-not-main) b="$(git branch --show-current)"; [ -n "$b" ] && [ "$b" != main ] && [ "$b" != master ] ;;
  file)     shift; [ "$(count "$@")" -ge 1 ] ;;
  count)    n="$2"; shift 2; [ "$(count "$@")" -ge "$n" ] ;;
  raw-intake)
    [ "$(count 'data/raw/*.csv')" -ge 4 ] && test -f data/raw/MANIFEST.sha256 \
      && ! git ls-files | grep -qE '\.csv$' ;;
  *) echo "unknown check: $1" >&2; exit 2 ;;
esac
